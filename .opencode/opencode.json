{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "wix-mcp": {
        "type": "remote",
        "url": "https://mcp.wix.com/mcp",
        "headers": {
          "wix-account-id": "{file:wix-account-id}"
        },
        "oauth": {}
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
