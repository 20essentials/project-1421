{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "wix-mcp": {
      "type": "remote",
      "url": "https://mcp.wix.com/mcp",
      "headers": {
        "Authorization": "<MODIFY...>🟢",
        "wix-account-id": "<MODIFY...>🟢"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1"
      ],
      "timeout": {
        "startup": 60000
      }
    }
  }
}
