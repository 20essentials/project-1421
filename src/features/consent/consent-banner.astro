---
import type { SiteChromeLabels } from "@/features/site-chrome/site-chrome-core";

interface Props {
  labels?: SiteChromeLabels;
}
const { labels = {} } = Astro.props;
const label = (key: string, fallback: string) => labels[key] || fallback;
---

<aside
  class="invisible fixed inset-x-0 bottom-0 z-40 translate-y-3 px-4 pb-4 opacity-0 transition-all duration-500 ease-fluid data-open:visible data-open:translate-y-0 data-open:opacity-100 sm:px-6"
  data-sl-consent
  role="region"
  aria-labelledby="sl-consent-title"
>
  <div class="mx-auto max-w-3xl border border-border bg-background shadow-xl">
    <div class="flex flex-col gap-5 p-6 sm:flex-row sm:items-start sm:justify-between sm:gap-10">
      <div class="consent-rise" style="--rise-delay: 80ms">
        <h2 id="sl-consent-title" class="font-display text-xl font-medium">{label("cookiePreferences", "Preferenze cookie")}</h2>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          {label("cookieBannerText", "Usiamo cookie tecnici necessari e, solo con il tuo consenso, cookie di analisi per capire come viene visitato il sito. Puoi cambiare scelta in qualsiasi momento dal footer.")}
        </p>
      </div>

      <div
        class="consent-rise grid w-full grid-cols-1 gap-2 sm:w-auto sm:flex sm:shrink-0 sm:flex-row sm:items-center"
        style="--rise-delay: 160ms"
      >
        <button
          type="button"
          data-consent-toggle
          aria-expanded="false"
          aria-controls="sl-consent-panel"
          class="consent-btn group rounded-control border border-border px-4 py-2.5 text-sm text-foreground no-underline hover:border-accent"
        >
          <span>{label("cookiePreferencesShort", "Preferenze")}</span>
          <svg
            class="consent-chev ml-2 inline-block size-3 align-[-2px]"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
          </svg>
        </button>
        <button
          type="button"
          data-consent-reject
          class="consent-btn rounded-control border border-border px-4 py-2.5 text-sm text-foreground no-underline hover:border-accent"
        >
          {label("rejectAll", "Rifiuta")}
        </button>
        <button
          type="button"
          data-consent-accept
          class="consent-btn group rounded-control border border-foreground bg-foreground px-4 py-2.5 text-sm font-medium text-primary-foreground no-underline hover:border-accent hover:bg-accent"
        >
          {label("acceptAll", "Accetta")}
          <svg
            class="consent-arrow ml-2 inline-block size-3 align-[-2px]"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M1 6h9M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="sl-consent-panel" class="consent-panel" data-consent-panel aria-hidden="true">
      <div class="consent-panel-clip">
        <div class="border-t border-border px-6 pb-6 pt-5">
          <div class="consent-rise" style="--rise-delay: 240ms">
            <p class="eyebrow">{label("categoriesLabel", "Categorie")}</p>
            <div class="mt-3 grid gap-1 sm:grid-cols-2">
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" checked disabled class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("necessaryCategory", "Necessari")}</span>
                  <span class="block text-muted-foreground">{label("necessaryDescription", "Sempre attivi.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" data-consent-key="functional" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("functionalCategory", "Funzionali")}</span>
                  <span class="block text-muted-foreground">{label("functionalDescription", "Ricordano le tue preferenze.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" data-consent-key="preferences" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("preferencesCategory", "Preferenze")}</span>
                  <span class="block text-muted-foreground">{label("preferencesDescription", "Personalizzano la navigazione.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" data-consent-key="analytics" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("analyticsCategory", "Analisi")}</span>
                  <span class="block text-muted-foreground">{label("analyticsDescription", "Statistiche anonime di visita.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" data-consent-key="marketing" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("marketingCategory", "Marketing")}</span>
                  <span class="block text-muted-foreground">{label("marketingDescription", "Misurazione delle campagne.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm">
                <input type="checkbox" data-consent-key="advertising" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("advertisingCategory", "Pubblicità")}</span>
                  <span class="block text-muted-foreground">{label("advertisingDescription", "Pixel e annunci personalizzati.")}</span>
                </span>
              </label>
              <label class="consent-row flex items-start gap-3 text-sm sm:col-span-2">
                <input type="checkbox" data-consent-key="dataToThirdParty" class="mt-0.5 size-4 accent-foreground" />
                <span>
                  <span class="font-medium">{label("thirdPartyCategory", "Dati a terze parti")}</span>
                  <span class="block text-muted-foreground">{label("thirdPartyDescription", "Trasferimento agli strumenti collegati.")}</span>
                </span>
              </label>
            </div>
            <div class="mt-5">
              <button
                type="button"
                data-consent-save
                class="consent-btn rounded-control border border-foreground bg-foreground px-5 py-2.5 text-sm font-medium text-primary-foreground no-underline hover:border-accent hover:bg-accent"
              >
                {label("savePreferences", "Salva preferenze")}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  try {
    const state = localStorage.getItem("sl_consent_v1");
    if (state !== "accepted" && state !== "rejected") {
      document.querySelector("[data-sl-consent]")?.setAttribute("data-open", "");
    }
  } catch {
  }
</script>

<style>
  /* Entrance stagger: title, copy and actions rise in sequence after the
     banner itself slides up (data-open on the aside). */
  [data-sl-consent] .consent-rise {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 500ms var(--ease-fluid, cubic-bezier(0.32, 0.72, 0, 1)),
      transform 500ms var(--ease-fluid, cubic-bezier(0.32, 0.72, 0, 1));
    transition-delay: var(--rise-delay, 0ms);
  }
  [data-sl-consent][data-open] .consent-rise {
    opacity: 1;
    transform: none;
  }

  /* Press feedback on top of the shared ripple: the control sinks slightly
     instead of only lifting on hover. */
  [data-sl-consent] .consent-btn:active {
    transform: translateY(0) scale(0.97);
    box-shadow: none;
  }

  /* Chevron / arrow micro-interactions */
  .consent-chev,
  .consent-arrow {
    transition: transform 350ms var(--ease-fluid, cubic-bezier(0.32, 0.72, 0, 1));
  }
  .consent-btn[aria-expanded='true'] .consent-chev {
    transform: rotate(180deg);
  }
  .consent-btn:hover .consent-arrow {
    transform: translateX(2px);
  }

  /* The preferences panel expands with a grid-rows animation instead of a
     hard hidden/unhidden swap. */
  .consent-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms var(--ease-fluid, cubic-bezier(0.32, 0.72, 0, 1));
  }
  .consent-panel[data-panel-open='true'] {
    grid-template-rows: 1fr;
  }
  .consent-panel-clip {
    overflow: hidden;
    min-height: 0;
    visibility: hidden;
    transition: visibility 0s 450ms;
  }
  .consent-panel[data-panel-open='true'] .consent-panel-clip {
    visibility: visible;
    transition: visibility 0s;
  }

  /* Row hover feedback in the category grid */
  .consent-row {
    padding: 0.5rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 2px;
    transition: background-color 250ms var(--ease-fluid, cubic-bezier(0.32, 0.72, 0, 1));
  }
  .consent-row:hover {
    background-color: color-mix(in srgb, var(--color-secondary) 70%, transparent);
  }
  .consent-row:has(input:checked:not(:disabled)) {
    background-color: color-mix(in srgb, var(--color-secondary) 90%, transparent);
  }
</style>

<script>
  import {
    getConsentState,
    getGranularPreferences,
    saveConsentPreferences,
    setConsentState,
    type GranularConsentPreferences,
  } from "@/shared/consent";

  const banner = document.querySelector<HTMLElement>("[data-sl-consent]");

  if (banner) {
    const panel = banner.querySelector<HTMLElement>("[data-consent-panel]");
    const checkboxes = [
      ...banner.querySelectorAll<HTMLInputElement>("[data-consent-key]"),
    ];

    const syncCheckboxes = () => {
      const saved = getGranularPreferences();
      for (const input of checkboxes) {
        const key = input.dataset.consentKey as keyof GranularConsentPreferences;
        input.checked = saved[key] === true;
      }
    };

    const setPanel = (open: boolean) => {
      if (!panel) return;
      panel.setAttribute("data-panel-open", String(open));
      panel.setAttribute("aria-hidden", String(!open));
      if ("inert" in panel) (panel as HTMLElement).inert = !open;
    };

    const open = (withPanel = false) => {
      banner.setAttribute("data-open", "");
      if (panel) {
        setPanel(withPanel);
        if (withPanel) syncCheckboxes();
      }
    };

    const close = () => {
      banner.removeAttribute("data-open");
      if (panel) setPanel(false);
    };

    if (!getConsentState()) open();

    banner.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
      setConsentState("accepted");
      close();
    });

    banner.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
      setConsentState("rejected");
      close();
    });

    banner.querySelector("[data-consent-toggle]")?.addEventListener("click", () => {
      if (!panel) return;
      const isOpen = panel.getAttribute("data-panel-open") === "true";
      if (!isOpen) syncCheckboxes();
      panel.setAttribute("data-panel-open", String(!isOpen));
      panel.setAttribute("aria-hidden", String(isOpen));
      if ("inert" in panel) (panel as HTMLElement).inert = isOpen;
      banner
        .querySelector<HTMLButtonElement>("[data-consent-toggle]")
        ?.setAttribute("aria-expanded", String(!isOpen));
    });

    banner.querySelector("[data-consent-save]")?.addEventListener("click", () => {
      const preferences: GranularConsentPreferences = {
        essential: true,
        functional: false,
        preferences: false,
        analytics: false,
        marketing: false,
        advertising: false,
        dataToThirdParty: false,
      };
      for (const input of checkboxes) {
        const key = input.dataset.consentKey as keyof GranularConsentPreferences;
        Object.assign(preferences, { [key]: input.checked });
      }
      saveConsentPreferences(preferences);
      close();
    });

    for (const trigger of document.querySelectorAll("[data-consent-settings]")) {
      trigger.addEventListener("click", () => open(true));
    }
  }
</script>
