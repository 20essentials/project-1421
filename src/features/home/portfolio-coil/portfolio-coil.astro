---
import { FallbackGrid } from './fallback-grid';
import type { ReelProject } from './engine';
import { imgSrc } from "@/shared/media";

// Photos scraped from stefanolunardi.com and uploaded to the site's Media
// Manager (villa-tramonto, ponte-rialto, ultima-corsa, la-spider, sotto-il-velo,
// la-risata, le-lacrime, lo-sposo-e-i-suoi; originals ~2560×1707 landscape).
// The reel plane is 2.38:1.571, so texture URLs are issued at that ratio.
const COIL_TEXTURE_W = 1600;
const COIL_TEXTURE_H = Math.round(1600 / (2.38 / 1.5771));

const villaTramonto = "wix:image://v1/600582_df7a8eb68bfe4ab1a7efa164b99fa4eb~mv2.jpg/villa-tramonto.jpg#originWidth=2560&originHeight=1707";
const ponteRialto = "wix:image://v1/600582_427b0dbc57e1452586cfc6eec96033d4~mv2.jpg/ponte-rialto.jpg#originWidth=2560&originHeight=1707";
const ultimaCorsa = "wix:image://v1/600582_b669998523e74ce89c899fb59ace2296~mv2.jpg/ultima-corsa.jpg#originWidth=2000&originHeight=1372";
const laSpider = "wix:image://v1/600582_e9087de0024847929ce4c7299d835dbf~mv2.jpg/la-spider.jpg#originWidth=2560&originHeight=1707";
const sottoIlVelo = "wix:image://v1/600582_af6e9a592a9a49b49f8329582bbe2fe0~mv2.jpg/sotto-il-velo.jpg#originWidth=2560&originHeight=1707";
const laRisata = "wix:image://v1/600582_b0b1bd8e531b4038a985e740a4957546~mv2.jpg/la-risata.jpg#originWidth=2000&originHeight=1329";
const leLacrime = "wix:image://v1/600582_33ae8889307244c3903778a51806562d~mv2.jpg/le-lacrime.jpg#originWidth=2000&originHeight=1333";
const loSposoEIuoi = "wix:image://v1/600582_5c66f96caf7a41fc85e4525826840989~mv2.jpg/lo-sposo-e-i-suoi.jpg#originWidth=2000&originHeight=1333";

const projects: ReelProject[] = [
  {
    name: 'Villa al tramonto',
    category: 'Destination wedding',
    description:
      'La villa si accende al calar del buio: il ricevimento ripreso dall’alto, tra cipressi e colline venete.',
    image: imgSrc(villaTramonto, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'Ponte di Rialto',
    category: 'Venezia',
    description:
      'Il bacio sotto la pietra del Rialto, riflesso nel Canal Grande mentre la città continua a vivere.',
    image: imgSrc(ponteRialto, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'L’ultima corsa',
    category: 'Reportage',
    description:
      'La macchina degli sposi torna a casa all’imbrunire, i fari accesi tra i filari e un cielo che brucia.',
    image: imgSrc(ultimaCorsa, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'La spider',
    category: 'Reportage',
    description:
      'Gli sposi lungo il lago in una cabriolet d’epoca: movimento, luce naturale e niente posa.',
    image: imgSrc(laSpider, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'Sotto il velo',
    category: 'Fine Art',
    description:
      'Due volti nella penombra del fienile, avvolti dal velo: solo luce naturale e un’emozione vera.',
    image: imgSrc(sottoIlVelo, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'La risata',
    category: 'Reportage',
    description:
      'Il velo al vento e una risata che non si può ripetere: l’attimo reale, non la posa.',
    image: imgSrc(laRisata, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'Le lacrime',
    category: 'Emozioni',
    description:
      'I genitori durante lo scambio degli anelli: la foto che nessuno ordina, ma che tutti ricordano.',
    image: imgSrc(leLacrime, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  },
  {
    name: 'Lo sposo e i suoi',
    category: 'Venezia',
    description:
      'Lo sposo in giacca bianca disceso dallo scalinale della villa, gli amici un passo dietro di lui.',
    image: imgSrc(loSposoEIuoi, COIL_TEXTURE_W, COIL_TEXTURE_H),
    link: '/portfolio'
  }
];
---

<div class='coil-wrap' data-coil-wrap>
<section class='coil' data-coil role='region' aria-label='Reel dei progetti di matrimonio' tabindex='0'>
  <h2 class='coil-headline'>Storie vere.<br />Prospettive rare.</h2>
  <canvas class='coil-canvas' data-coil-canvas role='img'></canvas>
  <FallbackGrid client:only='react' projects={projects} />
  <p class='coil-hint' data-coil-hint>Scrolla o trascina per esplorare</p>
  <p class='coil-live' data-coil-live aria-live='polite'></p>
  <script type='application/json' data-coil-projects set:html={JSON.stringify(projects)} />
</section>
</div>

<style is:global>
  .coil-wrap {
    /* Scroll pin: the page flows through 300vh while the reel stage stays
       fixed; when the wrapper ends, the next section continues naturally. */
    position: relative;
    height: 300vh;
  }

  .coil {
    /* Stage taller than the viewport (150vh), pinned so its vertical middle
       band is on screen: the cards get extra headroom instead of the
       viewport's hard edges. */
    position: sticky;
    top: -25vh;
    height: 150vh;
    min-height: 150vh;
    background-color: var(--color-background, #ffffff);
    overflow: hidden;
    outline: none;
  }

  .coil::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(28, 32, 42, 0.14) 0.6px,
      transparent 0.8px
    );
    background-size: 6px 6px;
    opacity: 0.5;
    pointer-events: none;
    z-index: 1;
  }

  .coil::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      radial-gradient(1200px 700px at 24% 12%, rgba(255, 255, 255, 0.65), transparent 70%),
      radial-gradient(1500px 900px at 78% 88%, rgba(28, 32, 42, 0.08), transparent 72%),
      radial-gradient(900px 620px at 70% 30%, rgba(240, 240, 244, 0.4), transparent 75%);
  }

  .coil:focus-visible {
    outline: 2px solid var(--color-accent, #23262e);
    outline-offset: -2px;
  }

  @media (max-width: 767px) {
    .coil {
      top: 0;
      height: 100dvh;
      min-height: 100dvh;
    }

    .coil-headline {
      font-size: clamp(2.6rem, 11vw, 4rem);
    }
  }

  .coil-headline {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: 100%;
    text-align: center;
    font-family: var(--font-display, 'Jost', serif);
    font-size: clamp(3.2rem, 8.8vw, 9rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 500;
    color: var(--color-foreground, #1c202a);
    pointer-events: none;
  }

  .coil-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    touch-action: pan-y;
    cursor: grab;
  }

  .coil-canvas[data-coil-grabbing] {
    cursor: grabbing;
  }

  .coil-hint {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    z-index: 4;
    text-align: center;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(28, 32, 42, 0.55);
    pointer-events: none;
  }

  .coil-live,
  .coil-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .coil-fallback {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow-y: auto;
    padding: 4rem 1.5rem;
  }

  .coil-fallback-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .coil-fallback-grid figure {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(28, 32, 42, 0.12);
    border-radius: 2px;
    padding: 0.9rem;
  }

  .coil-fallback-grid img {
    width: 100%;
    aspect-ratio: 1200 / 796;
    object-fit: cover;
    border-radius: 2px;
    display: block;
  }

  .coil-fallback-grid figcaption {
    font-family: var(--font-display, 'Jost', serif);
    font-size: 1.1rem;
    margin-top: 0.6rem;
  }

  .coil-fallback-grid p {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    color: rgba(28, 32, 42, 0.75);
    margin-top: 0.15rem;
  }
</style>

<script>
  import { mountReel } from './mount';

  const section = document.querySelector<HTMLElement>('[data-coil]');
  if (section) mountReel(section);
</script>
