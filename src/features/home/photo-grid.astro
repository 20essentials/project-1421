---
import type { ImageMetadata } from "astro";
import p01 from "@/assets/photos/01-autentiche.webp";
import p02 from "@/assets/photos/02-autentiche.webp";
import p03 from "@/assets/photos/03-autentiche.webp";
import p04 from "@/assets/photos/04-autentiche.webp";
import p05 from "@/assets/photos/05-autentiche.webp";
import p06 from "@/assets/photos/06-autentiche.webp";
import p07 from "@/assets/photos/07-eleganti.webp";
import p08 from "@/assets/photos/08-eleganti.webp";
import p09 from "@/assets/photos/09-eleganti.webp";
import p10 from "@/assets/photos/10-eleganti.webp";
import p11 from "@/assets/photos/11-eleganti.webp";
import p12 from "@/assets/photos/12-eleganti.webp";
import p13 from "@/assets/photos/13-eleganti.webp";
import p14 from "@/assets/photos/14-autentiche.webp";
import p15 from "@/assets/photos/15-autentiche.webp";
import p16 from "@/assets/photos/16-autentiche.webp";
import p17 from "@/assets/photos/17-autentiche.webp";
import p18 from "@/assets/photos/18-eleganti.webp";

interface Props {
  eyebrow?: string;
  title?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow = "Portfolio", title = "MOMENTI VERI, composti con eleganza", ctaLabel = "Guarda tutto il portfolio", ctaHref = "/portfolio" } = Astro.props;

type PhotoTile = {
  src: ImageMetadata;
  category: "autentiche e naturali" | "eleganti e iconiche";
};

const photos: PhotoTile[] = [
  { src: p01, category: "autentiche e naturali" },
  { src: p02, category: "autentiche e naturali" },
  { src: p03, category: "autentiche e naturali" },
  { src: p04, category: "autentiche e naturali" },
  { src: p05, category: "autentiche e naturali" },
  { src: p06, category: "autentiche e naturali" },
  { src: p07, category: "eleganti e iconiche" },
  { src: p08, category: "eleganti e iconiche" },
  { src: p09, category: "eleganti e iconiche" },
  { src: p10, category: "eleganti e iconiche" },
  { src: p11, category: "eleganti e iconiche" },
  { src: p12, category: "eleganti e iconiche" },
  { src: p13, category: "eleganti e iconiche" },
  { src: p14, category: "autentiche e naturali" },
  { src: p15, category: "autentiche e naturali" },
  { src: p16, category: "autentiche e naturali" },
  { src: p17, category: "autentiche e naturali" },
  { src: p18, category: "eleganti e iconiche" },
];
---

<section class="dot-grid dot-grid-light bg-foreground px-6 py-20" aria-labelledby="photo-grid-title">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary-foreground/60">{eyebrow}</p>
        <h2 id="photo-grid-title" class="font-display mt-3 max-w-2xl text-3xl font-medium leading-tight text-primary-foreground sm:text-4xl">
          {title}
        </h2>
      </div>
      <a href={ctaHref} class="text-sm text-primary-foreground/80 underline-offset-4 no-underline transition-colors hover:text-primary-foreground hover:underline">
        {ctaLabel}
      </a>
    </div>

    <div class="bento-grid">
      {
        photos.map((photo, i) => {
          const alt = `Fotografia di matrimonio — ${photo.category} — Stefano Lunardi`;
          return (
            <button type="button" class="bento-tile" aria-label={alt} aria-haspopup="dialog">
              <img
                src={photo.src.src}
                width={photo.src.width}
                height={photo.src.height}
                alt={alt}
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
              />
            </button>
          );
        })
      }
    </div>
  </div>

  <div class="pg-lightbox" role="dialog" aria-modal="true" aria-label="Fotografia" hidden>
    <img class="pg-lightbox__img" alt="" decoding="async" />
    <button type="button" class="pg-lightbox__close" aria-label="Chiudi l'immagine a schermo intero">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</section>

<script>
  import { mountPhotoGridZoom } from "@/features/home/photo-grid-zoom";
  mountPhotoGridZoom();
</script>

<style>
  /* Masonry de costo único: columnas CSS con las imágenes a su proporción
     natural. width/height del SSR reservan el hueco antes del decode. */
  .bento-grid {
    column-count: 4;
    column-gap: clamp(10px, 1vw, 16px);
  }

  .bento-tile {
    display: block;
    position: relative;
    width: 100%;
    margin: 0 0 clamp(10px, 1vw, 16px);
    padding: 0;
    break-inside: avoid;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background-color: var(--color-secondary);
    cursor: zoom-in;
    transition: border-color 0.4s ease;
  }

  .bento-tile:focus-visible {
    outline: 2px solid var(--color-primary-foreground);
    outline-offset: 2px;
  }

  .bento-tile :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.7s var(--ease-fluid);
  }

  .bento-tile:hover {
    border-color: rgb(255 255 255 / 0.24);
  }

  .bento-tile:hover :global(img) {
    transform: scale(1.05);
  }

  @media (max-width: 900px) {
    .bento-grid {
      column-count: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-tile,
    .bento-tile :global(img) {
      transition: none;
    }

    .bento-tile:hover :global(img) {
      transform: none;
    }
  }
</style>
