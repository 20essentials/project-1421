---
/**
 * Sección con rotación automática de imágenes (cada `interval` ms cambia la
 * imagen con una animación de clip-path) y texto centrado "Foto Artistiche".
 * Dos capas <img> se alternan: la entrante se revela desde inset(50%) hasta
 * cubrir todo, la saliente se recoloca en el índice siguiente precargada.
 * El fondo queda anclado al viewport con `position: fixed` en las capas y la
 * sección lo recorta con `clip-path: inset(0)`: un background-attachment:
 * fixed que también funciona en iOS. Sin JS/copy: reduced-motion desactiva
 * el ciclo y deja la primera imagen fija.
 */
import { imgSrc, imgSrcSet } from "@/shared/media";

interface Slide {
  fileId: string;
  alt: string;
  ratio: number;
}

// Obras de "foto artistiche non matrimoni", subidas al Media Manager (hasta 2560px de ancho).
const SLIDES: Slide[] = [
  { fileId: "600582_645c3b2069924c4d9d22c831960610bc~mv2.avif", alt: "Composición abstracta de una cancha de baloncesto en azul y amarillo", ratio: 1709 / 2560 },
  { fileId: "600582_952517e626b944c595faaae8305e3e3a~mv2.avif", alt: "Doble página del libro con hayas otoñales rojas", ratio: 1938 / 2560 },
  { fileId: "600582_81c8c78d5efc4f658f530e2fce649cbe~mv2.jpg", alt: "Agua turquesa de una piscina con reflejos de luz", ratio: 1707 / 2560 },
  { fileId: "600582_03973b946ad049e7bd4f01400d73938f~mv2.jpg", alt: "Raíces musgosas de un árbol entre hojas rojas de otoño", ratio: 1000 / 1500 },
  { fileId: "600582_1c73e1038d4e4090921619cfbbb95527~mv2.avif", alt: "Mosaico de asientos de estadio en colores primarios", ratio: 1707 / 2560 },
  { fileId: "600582_aed8667f92a94637929161ff3e119f92~mv2.jpg", alt: "Pinturas de luz enmarcadas expuestas en una galería", ratio: 1920 / 2560 },
  { fileId: "600582_13df9a5cc79d464da939d88c29fc5401~mv2.jpg", alt: "Obra de un águila real enmarcada en un interior de hormigón", ratio: 1500 / 2000 },
  { fileId: "600582_aca468f1e727401e8f170b90fe9b6405~mv2.jpg", alt: "Árbol nevado en blanco y negro sobre el libro My Vision of Kärnten", ratio: 1920 / 2560 },
  { fileId: "600582_b806236b4181420b97073ec3a372f30b~mv2.jpg", alt: "Obra abstracta en blanco y negro enmarcada en un interior minimalista", ratio: 1500 / 2000 },
  { fileId: "600582_47f6d11c0d1b4f1fa8b94410b0dfa619~mv2.jpg", alt: "Río blanco entre rocas oscuras en blanco y negro", ratio: 1153 / 1200 },
];

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = "/fine-art", ctaLabel = "Scopri le opere" } = Astro.props;

const INTERVAL = 5000;
const WIDTHS = [1280, 1600, 2000, 2400];
const slides = SLIDES.map((s) => ({
  src: imgSrc(s.fileId, 2400, Math.round(2400 * s.ratio)),
  srcSet: imgSrcSet(s.fileId, WIDTHS, s.ratio),
  alt: s.alt,
}));
---

<section
  class="art-parallax"
  data-gallery
  data-interval={INTERVAL}
  data-slides={JSON.stringify(slides)}
  aria-label="Galería automática de fotografías artísticas"
>
  <img
    class="art-parallax__layer is-active"
    data-layer="0"
    src={slides[0].src}
    srcset={slides[0].srcSet}
    sizes="100vw"
    fetchpriority="high"
    decoding="async"
    alt={slides[0].alt}
  />
  <img
    class="art-parallax__layer"
    data-layer="1"
    src={slides[1].src}
    srcset={slides[1].srcSet}
    sizes="100vw"
    aria-hidden="true"
    decoding="async"
    alt={slides[1].alt}
  />
  <div class="art-parallax__scrim"></div>
  <div class="art-parallax__copy">
    <p class="eyebrow">Fine Art</p>
    <h2 class="font-display art-parallax__title">Foto Artistiche</h2>
    <p class="art-parallax__line">Opere che portano l'invisibile nel visibile: luce, composizione, atmosfera.</p>
    {ctaHref && ctaLabel && <a href={ctaHref} class="art-parallax__cta">{ctaLabel}</a>}
  </div>
</section>

<script>
  import type { ArtParallaxElement } from "./artistic-parallax-types";

  const DURATION = 1500;
  const galleries = document.querySelectorAll<ArtParallaxElement>("[data-gallery]");

  for (const gallery of galleries) {
    const slides = JSON.parse(gallery.dataset.slides ?? "[]") as { src: string; srcSet?: string; sizes?: string; alt: string }[];
    const layers = Array.from(gallery.querySelectorAll<HTMLImageElement>("[data-layer]"));
    const total = slides.length;
    const interval = Number(gallery.dataset.interval) || 5000;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let index = 0;
    let active = 0;
    let timer: number | undefined;
    let cleanup: number | undefined;

    const preload = (layer: HTMLImageElement, slide: { src: string; srcSet?: string; sizes?: string; alt: string }) => {
      // srcset gana sobre src: hay que actualizarlo junto, o el navegador seguiría
      // sirviendo la imagen inicial del srcset y el ciclo mostraría solo 2 fotos.
      layer.srcset = slide.srcSet ?? "";
      layer.src = slide.src;
      layer.alt = slide.alt;
    };

    layers[0] && (layers[0].style.zIndex = "1");
    layers[1] && (layers[1].style.zIndex = "0");
    layers[1] && total > 1 && preload(layers[1], slides[1]);

    const reveal = () => {
      if (total < 2) return;

      const outgoing = layers[active];
      const incoming = layers[1 - active];
      if (!outgoing || !incoming) return;

      index = (index + 1) % total;
      incoming.style.zIndex = "2";
      outgoing.style.zIndex = "1";
      incoming.style.transition = "none";
      incoming.classList.remove("is-active");
      void incoming.offsetWidth;
      incoming.style.transition = "";
      incoming.classList.add("is-active");
      incoming.setAttribute("aria-hidden", "false");
      outgoing.setAttribute("aria-hidden", "true");
      active = 1 - active;

      if (cleanup !== undefined) window.clearTimeout(cleanup);
      cleanup = window.setTimeout(() => {
        outgoing.style.transition = "none";
        outgoing.classList.remove("is-active");
        outgoing.style.zIndex = "0";
        void outgoing.offsetWidth;
        outgoing.style.transition = "";
        preload(outgoing, slides[(index + 1) % total]);
        cleanup = undefined;
      }, DURATION);
    };

    const stop = () => {
      if (timer === undefined) return;
      window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      timer = window.setInterval(reveal, interval);
    };

    const sync = () => (document.hidden || reduced.matches ? stop() : start());

    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener?.("change", sync);
    sync();
  }
</script>

<style>
  .art-parallax {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* El clip-path encierra las capas fixed dentro de la sección: el fondo
       queda anclado al viewport y la sección lo recorta al pasar. Es el
       background-attachment: fixed que sí funciona en iOS. */
    clip-path: inset(0);
    background: #08090b;
  }
  .art-parallax__layer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    clip-path: inset(50% 50% 50% 50%);
    transition: clip-path 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .art-parallax__layer.is-active {
    clip-path: inset(-25% -25% -25% -25%);
  }
  @media (prefers-reduced-motion: reduce) {
    .art-parallax__layer {
      transition: none;
      clip-path: none;
    }
    .art-parallax__layer:not(.is-active) {
      display: none;
    }
  }
  .art-parallax__scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.25) 45%, transparent 72%);
    pointer-events: none;
  }
  .art-parallax__copy {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.5rem;
    color: var(--color-primary-foreground, #fff);
    pointer-events: none;
  }
  .art-parallax__copy .eyebrow {
    color: rgb(255 255 255 / 0.85);
  }
  .art-parallax__title {
    margin-top: 0.75rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  .art-parallax__line {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.4);
  }
  @media (min-width: 640px) {
    .art-parallax__line {
      font-size: 1.05rem;
    }
  }
  .art-parallax__cta {
    pointer-events: auto;
    margin-top: 1.75rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .art-parallax__cta:hover {
    border-color: rgb(255 255 255 / 1);
    background: rgb(255 255 255 / 0.1);
  }
</style>
