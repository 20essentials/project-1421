---
// Shared renderer for the legal Single Item pages: header (eyebrow/title/intro/version)
// + the document body from the CMS rich-text field + the fixed closing note.
import type { SitePageContent } from "@/features/site-content/site-content-core";
import "@/features/site-content/site-content.css";

interface Props {
  content: SitePageContent;
}

const { content } = Astro.props;
---

<div class="mx-auto max-w-6xl px-6 pb-24 pt-16">
  <header class="border-b border-border pb-10">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-4 text-4xl font-medium sm:text-5xl">{content.title}</h1>
    <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
    {content.version && (
      <p class="mt-5 text-xs uppercase tracking-[0.2em] text-muted-foreground">{content.version}</p>
    )}
  </header>
  <section class="site-content-body mx-auto max-w-3xl py-14" set:html={content.bodyHtml} />
  <p class="text-sm leading-relaxed text-muted-foreground">
    Per richieste, chiarimenti o esercizio dei propri diritti è possibile utilizzare le informazioni di contatto riportate nel footer del sito.
  </p>
</div>
