---
import type { Locale } from "@/features/i18n/locale";
import { localizedHref } from "@/features/i18n/localized-path";
import { HOME_SECTIONS_COPY } from "@/features/home/home-sections-copy";
import { formatReviewDate, getHomeReviews } from "@/features/reviews/reviews";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_SECTIONS_COPY[locale].reviews;
const reviews = getHomeReviews();
const plates = ["featured", "second", "third", "fourth", "fifth", "sixth"] as const;
---

<section id="recensioni-home" aria-labelledby="recensioni-home-title" class="border-b border-border px-6 py-20">
  <div class="reviews-archive mx-auto max-w-6xl">
    <div class="reviews-archive__heading">
      <h2 id="recensioni-home-title" class="reviews-archive__title font-display">{copy.title}</h2>
      <p class="reviews-archive__intro">{copy.intro}</p>
      <div class="reviews-archive__cta">
        <a
          href={localizedHref(locale, "/recensioni")}
          class="rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent"
        >
          {copy.cta}
        </a>
      </div>
    </div>

    <div class="reviews-archive__grid">
      {
        reviews.map((review, index) => (
          <article class="reviews-archive__card" data-plate={plates[index]}>
            <blockquote class="reviews-archive__quote">“{review.excerpt}”</blockquote>
            <footer class="reviews-archive__footer">
              <span class="reviews-archive__name">{review.name}</span>
              <span class="reviews-archive__meta">
                {copy.newlyweds} · {formatReviewDate(locale, review.date)} · {review.location}
              </span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews-archive {
    container: reviews / inline-size;
  }

  .reviews-archive__heading {
    display: grid;
    gap: 0.875rem;
    margin-block-end: 2.25rem;
  }

  .reviews-archive__title {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .reviews-archive__intro {
    margin: 0;
    max-inline-size: 36rem;
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--color-muted-foreground);
  }

  .reviews-archive__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "featured"
      "second"
      "third"
      "fourth"
      "fifth"
      "sixth";
    gap: 0.875rem;
  }

  .reviews-archive__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    min-inline-size: 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .reviews-archive__card[data-plate="featured"] { grid-area: featured; }
  .reviews-archive__card[data-plate="second"] { grid-area: second; }
  .reviews-archive__card[data-plate="third"] { grid-area: third; }
  .reviews-archive__card[data-plate="fourth"] { grid-area: fourth; }
  .reviews-archive__card[data-plate="fifth"] { grid-area: fifth; }
  .reviews-archive__card[data-plate="sixth"] { grid-area: sixth; }

  .reviews-archive__quote {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  .reviews-archive__footer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block-start: 0.875rem;
    border-block-start: 1px solid var(--color-border);
  }

  .reviews-archive__name {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reviews-archive__meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .reviews-archive__cta {
    display: flex;
    justify-content: flex-start;
    padding-block-start: 0.375rem;
  }

  @container reviews (inline-size > 40rem) {
    .reviews-archive__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        "featured featured featured second second second"
        "third third fourth fourth fifth fifth";
      gap: 1rem;
    }

    .reviews-archive__card {
      padding: 1.5rem;
    }

    .reviews-archive__quote {
      font-size: 1.0625rem;
    }
  }

  @container reviews (inline-size > 48rem) {
    .reviews-archive__heading {
      gap: 1rem;
      margin-block-end: 2.75rem;
    }

    .reviews-archive__title {
      font-size: 3rem;
    }
  }

  @container reviews (inline-size > 64rem) {
    .reviews-archive__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "featured featured featured featured featured second second second second third third third"
        "fourth fourth fourth fourth fifth fifth fifth fifth sixth sixth sixth sixth";
      gap: 1rem;
    }

    .reviews-archive__quote {
      font-size: 1.125rem;
      line-height: 1.7;
    }

    .reviews-archive__card[data-plate="featured"] .reviews-archive__quote {
      font-size: 1.25rem;
      line-height: 1.6;
    }
  }
</style>
