---
export interface GridVideo {
  id: string;
  title: string;
}

const { videos } = Astro.props as { videos: GridVideo[] };
---

<script>
  import "@justinribeiro/lite-youtube";
</script>

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    videos.map((video) => (
      <figure>
        <lite-youtube
          videoid={video.id}
          videoTitle={video.title}
          playlabel={`Riproduci: ${video.title}`}
          params="rel=0"
          class="border border-border"
        />
        <figcaption class="mt-3 text-sm text-muted-foreground">{video.title}</figcaption>
      </figure>
    ))
  }
</div>
