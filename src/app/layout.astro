---
import "@/styles/global.css";
import SiteHeader from "@/app/header.astro";
import SchemaForm from "@/features/forms/schema-form";
import { getForm } from "@/features/forms/forms";
import type { FormDto } from "@/features/forms/types";
import ConsentBootstrap from "@/features/consent/consent-bootstrap.astro";
import ConsentBanner from "@/features/consent/consent-banner.astro";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;

const NEWSLETTER_FORM_ID = "99167414-c329-4e8f-8f02-db033652f376";

let newsletterForm: FormDto | null = null;
try {
  newsletterForm = await getForm(NEWSLETTER_FORM_ID);
} catch {
}

const primaryNav = [
  { href: "/portfolio", label: "Portfolio" },
  { href: "/il-mio-metodo", label: "Il metodo" },
  { href: "/chi-sono", label: "Chi sono" },
  { href: "/location", label: "Location" },
  { href: "/investimento", label: "Investimento" },
  { href: "/blog", label: "Storie" },
  { href: "/faq", label: "FAQ" },
];
const secondaryNav = [
  { href: "/recensioni", label: "Recensioni" },
  { href: "/awards", label: "Awards" },
  { href: "/fine-art", label: "Fine Art" },
];
const allNav = [...primaryNav.slice(0, 5), ...secondaryNav, ...primaryNav.slice(5)];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const publicUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;
const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "") || new URL(publicUrl).origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const resolvedTitle =
  title ?? "Stefano Lunardi — Fotografo di matrimoni | Fine Art | Fotoreporter";
const resolvedDescription =
  description ??
  "Fotografia di matrimonio fine art in Italia e Austria: storie autentiche, emozioni e ricordi che restano.";
const hasSeoTags = Astro.slots.has("seo-tags");
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Stefano Lunardi",
  url: origin,
  jobTitle: "Fotografo di matrimoni",
  knowsAbout: ["Fotografia di matrimonio", "Fine Art", "Fotoreportage"],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#1a1d23" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1d23" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {!hasSeoTags && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="it_IT" />
        <meta property="og:site_name" content="Stefano Lunardi" />
        <meta property="og:title" content={resolvedTitle} />
        <meta property="og:description" content={resolvedDescription} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={resolvedTitle} />
        <meta name="twitter:description" content={resolvedDescription} />
        <script type="application/ld+json" is:inline set:html={structuredData} />
      </>
    )}
    <slot name="seo-tags" />
    <ConsentBootstrap />
  </head>
  <body>
    <SiteHeader navPrimary={primaryNav} navAll={allNav} current={currentPath} />
    <main id="contenido">
      <slot />
    </main>
    <footer class="border-t border-border px-6 pb-10 pt-16">
      <div class="mx-auto max-w-7xl">
        <section class="mx-auto max-w-xl border-b border-border pb-14 text-center">
          <p class="eyebrow">Aggiornamenti esclusivi</p>
          <h2 class="font-display mt-3 text-2xl font-medium sm:text-3xl">La newsletter di Stefano</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Nuovi lavori, premi e storie dietro le quinte, una volta al mese. Niente spam.</p>
          <div class="mt-8 text-left">
            {newsletterForm ? (
              <SchemaForm client:load formId={NEWSLETTER_FORM_ID} initialForm={newsletterForm} />
            ) : (
              <p class="text-sm text-muted-foreground">L'iscrizione alla newsletter è temporaneamente non disponibile. Scrivici a studio@stefanolunardi.com.</p>
            )}
          </div>
        </section>
        <p class="font-display mx-auto max-w-3xl text-center text-2xl italic leading-snug sm:text-3xl">
          "Tutto è fugace, ma ciò che rimane è il ricordo."
        </p>
        <p class="mt-6 text-center text-xs uppercase tracking-[0.25em] text-muted-foreground">
          Autenticità · Contemplazione · Relazione · Arte · Emozione
        </p>
        <div class="mt-12 grid grid-cols-1 gap-10 text-sm sm:grid-cols-3">
          <div>
            <p class="eyebrow">Il sito</p>
            <nav class="mt-4 flex flex-col gap-2" aria-label="Footer">
              {allNav.map((l) => (
                <a href={l.href} class="text-foreground no-underline hover:text-accent">{l.label}</a>
              ))}
            </nav>
          </div>
          <div>
            <p class="eyebrow">Contatti</p>
            <div class="mt-4 flex flex-col gap-2">
              <a href="mailto:studio@stefanolunardi.com" class="text-foreground no-underline hover:text-accent">studio@stefanolunardi.com</a>
              <a href="tel:+393387513113" class="text-foreground no-underline hover:text-accent">+39 338 751 3113 (Italia)</a>
              <a href="tel:+436767517274" class="text-foreground no-underline hover:text-accent">+43 676 751 7274 (Austria)</a>
              <p class="text-muted-foreground">Villach · Udine · Treviso</p>
            </div>
          </div>
          <div>
            <p class="eyebrow">Segui</p>
            <div class="mt-4 flex flex-col gap-2">
              <a href="https://www.instagram.com/stefanolunardiphoto" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">Instagram</a>
              <a href="https://www.facebook.com/StefanoLunardiFotografo" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">Facebook</a>
              <a href="https://www.linkedin.com/in/stefano-lunardi-5b761526" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">LinkedIn</a>
              <a href="https://www.singulart.com" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">Singulart — opere fine art</a>
            </div>
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row">
          <p>© {new Date().getFullYear()} Stefano Lunardi — Fotografo di matrimoni | Fine Art | Fotoreporter</p>
          <div class="flex items-center gap-4">
            <button type="button" data-consent-settings class="no-underline hover:text-accent">
              Preferenze cookie
            </button>
            <a href="/impressum" class="no-underline hover:text-accent">Impressum</a>
          </div>
        </div>
      </div>
    </footer>
    <ConsentBanner />
    <script>
      import { mountRipple } from "@/shared/ripple";

      mountRipple();
    </script>
  </body>
</html>
