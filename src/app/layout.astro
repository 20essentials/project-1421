---
import { Font } from "astro:assets";
import "@/styles/global.css";
import SiteHeader from "@/app/header.astro";
import SchemaForm from "@/features/forms/schema-form";
import { getForm } from "@/features/forms/forms";
import type { FormDto } from "@/features/forms/types";
import ConsentBootstrap from "@/features/consent/consent-bootstrap.astro";
import ConsentBanner from "@/features/consent/consent-banner.astro";
import { allNav as allNavPaths, primaryNav as primaryNavPaths } from "@/app/nav";
import { currentLocale } from "@/features/i18n/current-locale";
import {
  DEFAULT_LOCALE,
  LOCALES,
  languageTag,
  ogLocale,
  type Locale,
} from "@/features/i18n/locale";
import {
  currentCleanPath,
  localizedCanonicalPath,
  localizedHref,
  localizedPath,
} from "@/features/i18n/localized-path";
import { getSiteChrome } from "@/features/site-chrome/site-chrome";
import { toNavItems } from "@/features/site-chrome/site-chrome-core";
import { fetchSiteInfo } from "@/features/site-info/site-info";
import { SITE_INFO_FALLBACKS, type SiteInfo } from "@/features/site-info/site-info-core";
import { shouldEmitSecondaryLocaleTitle } from "@/app/seo-head";

interface Props {
  title?: string;
  description?: string;
  /** Opt-in for pages WITHOUT dashboard-managed tags (dynamic app pages): emit the
   * fallback head tags in production too. Static pages never pass it — behind Wix
   * hosting their head tags are injected server-side from the dashboard's SEO
   * settings (Item SEO Tags), and emitting them here would duplicate every tag. */
  headFallback?: boolean;
}
const { title, description, headFallback = false } = Astro.props;
const NEWSLETTER_FORM_ID = "99167414-c329-4e8f-8f02-db033652f376";
const fontVariables = ["--font-inter", "--font-cormorant-garamond"] as const;

let newsletterForm: FormDto | null = null;
try {
  newsletterForm = await getForm(NEWSLETTER_FORM_ID, Astro.request.headers);
} catch {
}

// Business info from the dashboard (Settings > Business Info) with the studio's
// values as fallback — the page renders the same whether the owner filled the
// dashboard fields or not. The favicon follows the same idea: Wix serves the
// dashboard favicon (Settings > Website settings) at /favicon.ico on its own,
// and the local PNG set below is the fallback for the higher-resolution icons.
let siteInfo: SiteInfo | null = null;
try {
  siteInfo = await fetchSiteInfo();
} catch {
}
const info = siteInfo ?? SITE_INFO_FALLBACKS;

const locale = currentLocale(Astro.url, Astro.request.headers);
const currentPath = currentCleanPath(Astro.url.pathname);
const labels = await getSiteChrome(Astro.request.headers);
const navPrimary = toNavItems(primaryNavPaths, labels, locale);
const navAll = toNavItems(allNavPaths, labels, locale);
const label = (key: string, fallback: string) => labels[key] || fallback;
const copyright = label(
  "copyright",
  "© {year} Stefano Lunardi — Fotografo di matrimoni | Fine Art | Fotoreporter",
).replace("{year}", String(new Date().getFullYear()));

const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const publicUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;
const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "") || new URL(publicUrl).origin;
const localizedCanonical = localizedCanonicalPath(Astro.url.pathname, forwardedUrl, locale);
const canonical = new URL(localizedCanonical, origin).href;
const alternates = LOCALES.map((alternateLocale: Locale) => ({
  locale: alternateLocale,
  href: new URL(localizedPath(alternateLocale, currentPath), origin).href,
}));
const resolvedTitle =
  title ?? label("seoTitle", "Stefano Lunardi — Fotografo di matrimoni | Fine Art | Fotoreporter");
const resolvedDescription =
  description ??
  label(
    "seoDescription",
    "Fotografia di matrimonio fine art in Italia e Austria: storie autentiche, emozioni e ricordi che restano.",
  );
const hasSeoTags = Astro.slots.has("seo-tags");
// Static pages behind Wix hosting get their head tags injected server-side from the
// dashboard's SEO settings; local dev has no injection, so it emits the fallbacks.
const emitFallbackHead = import.meta.env.DEV || headFallback;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Stefano Lunardi",
  url: origin,
  jobTitle: label("jobTitle", "Fotografo di matrimoni"),
  knowsAbout: [
    label("knowsAboutWedding", "Fotografia di matrimonio"),
    label("knowsAboutFineArt", "Fine Art"),
    label("knowsAboutPhotojournalism", "Fotoreportage"),
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={languageTag(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {fontVariables.map((cssVariable) => (
      <Font cssVariable={cssVariable} preload={cssVariable === "--font-inter" || cssVariable === "--font-cormorant-garamond"} />
    ))}
    {/* Don't offer to translate / switch language: every page is already
        authored per locale (it/es/en/de) and the site redirects visitors by
        language itself. */}
    <meta name="google" content="notranslate" />
    <meta http-equiv="content-language" content={languageTag(locale)} />
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                {
                  "not": {
                    "selector_matches": [
                      "[href^='#']",
                      "[href^='mailto:']",
                      "[href^='tel:']",
                      "[target='_blank']",
                      "[download]",
                      "[data-locale-switch]"
                    ]
                  }
                }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    {import.meta.env.DEV && (
      <script is:inline>
        (() => {
          const href = (u) => (u instanceof URL ? u.href : u);
          const upgrade = (raw) => {
            const url = href(raw);
            if (typeof url !== "string") return url;
            if (url.startsWith("//frog.wix.com")) return "https:" + url;
            if (url.startsWith("http://frog.wix.com")) return "https://" + url.slice(7);
            return url;
          };
          const sendBeacon = navigator.sendBeacon?.bind(navigator);
          if (sendBeacon) {
            navigator.sendBeacon = (url, data) => sendBeacon(upgrade(url), data);
          }
          const doFetch = window.fetch?.bind(window);
          if (doFetch) {
            window.fetch = (input, init) =>
              doFetch(typeof input === "string" ? upgrade(input) : input, init);
          }
          const open = XMLHttpRequest.prototype.open;
          XMLHttpRequest.prototype.open = function (method, url, ...rest) {
            return open.call(this, method, upgrade(url), ...rest);
          };
          const hideFromWixEmbeds = (key) => {
            let value = window[key];
            Object.defineProperty(window, key, {
              configurable: true,
              enumerable: true,
              get() {
                return (new Error().stack || "").includes("setupContext-DcZmzUDt.js")
                  ? undefined
                  : value;
              },
              set(next) {
                value = next;
              },
            });
          };
          hideFromWixEmbeds("__wix_context__");
          hideFromWixEmbeds("$wixContext");
        })();
      </script>
    )}
    <link rel="icon" href="https://static.wixstatic.com/shapes/600582_b61128900f3b4f5da3e8d3fed66528e7.svg" type="image/svg+xml" />
    <link rel="icon" href="https://static.wixstatic.com/media/600582_8da5d525d72249298e640322b076e8f3~mv2.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="https://static.wixstatic.com/media/600582_2ae8b80b777540379b8366b38a897034~mv2.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="https://static.wixstatic.com/media/600582_c34d60f8b90240a1a671dc9b83c6c3b0~mv2.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1d23" />
    {emitFallbackHead && !hasSeoTags && (
      <>
        <title>{resolvedTitle}</title>
        <meta name="description" content={resolvedDescription} />
        <link rel="canonical" href={canonical} />
        {alternates.map((alternate) => (
          <link rel="alternate" hreflang={languageTag(alternate.locale)} href={alternate.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(DEFAULT_LOCALE, currentPath), origin).href} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocale(locale)} />
        <meta property="og:site_name" content={info.displayName} />
        <meta property="og:title" content={resolvedTitle} />
        <meta property="og:description" content={resolvedDescription} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={resolvedTitle} />
        <meta name="twitter:description" content={resolvedDescription} />
        <script type="application/ld+json" is:inline set:html={structuredData} />
      </>
    )}
    {/* Wix's viewer injects one locale-level title ("Es | …") for every page of a secondary
        locale and reuses it across client-side (soft) navigations. Static pages own their real
        title in the page data, so emit it — like the shipped templates do — and give the viewer
        a per-page tag to resolve on soft navigation. The default locale already gets its title
        from the dashboard; emitting a second one duplicates it. */}
    {shouldEmitSecondaryLocaleTitle(locale, emitFallbackHead, hasSeoTags, Boolean(title)) && (
      <>
        <title>{resolvedTitle}</title>
        {description && <meta name="description" content={resolvedDescription} />}
      </>
    )}
    <slot name="seo-tags" />
    <ConsentBootstrap />
    <script is:inline>
      (() => {
        const removeBanner = () => {
          const el = document.getElementById('wixheadless-banner-container');
          if (el) el.remove();
        };
        removeBanner();
        const observer = new MutationObserver(() => {
          requestAnimationFrame(removeBanner);
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
  </head>
  <body>
    <SiteHeader
      navPrimary={navPrimary}
      navAll={navAll}
      current={currentPath}
      locale={locale}
      labels={labels}
      email={info.email}
      phone={info.phone}
    />
    <main id="contenido">
      <slot />
    </main>
    <footer class="border-t border-border px-6 pb-10 pt-16">
      <div class="mx-auto max-w-7xl">
        <section class="mx-auto max-w-xl border-b border-border pb-14 text-center">
          <p class="eyebrow">{label("newsletterSubtitle", "Aggiornamenti esclusivi")}</p>
          <h2 class="font-display mt-3 text-2xl font-medium sm:text-3xl">{label("newsletterTitle", "La newsletter di Stefano")}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{label("newsletterDescription", "Nuovi lavori, premi e storie dietro le quinte, una volta al mese. Niente spam.")}</p>
          <div class="mt-8 text-left">
            {newsletterForm ? (
              <SchemaForm client:load formId={NEWSLETTER_FORM_ID} initialForm={newsletterForm} />
            ) : (
              <p class="text-sm text-muted-foreground">{label("newsletterUnavailable", "L'iscrizione alla newsletter è temporaneamente non disponibile. Scrivici a studio@stefanolunardi.com.")}</p>
            )}
          </div>
        </section>
        <div class="mx-auto mt-14 max-w-3xl text-center">
          <p class="font-display text-2xl italic leading-snug sm:text-3xl">
            "{label("footerQuote", "Tutto è fugace, ma ciò che rimane è il ricordo.")}"
          </p>
          <p class="mt-6 text-xs uppercase tracking-[0.25em] text-muted-foreground">
            {label("footerTagline", "Autenticità · Contemplazione · Relazione · Arte · Emozione")}
          </p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-10 text-sm sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="eyebrow">{label("siteLabel", "Il sito")}</p>
            <nav class="mt-4 flex flex-col gap-2" aria-label={label("footerAriaLabel", "Footer")}>
              {navAll.map((l) => (
                <a href={l.href} class="text-foreground no-underline hover:text-accent">{l.label}</a>
              ))}
            </nav>
          </div>
          <div>
            <p class="eyebrow">{label("legalDocuments", "Documenti legali")}</p>
            <nav class="mt-4 flex flex-col gap-2" aria-label={label("legalDocuments", "Documenti legali")}>
              <a href={localizedHref(locale, "/legal")} class="text-foreground no-underline hover:text-accent">{label("allDocuments", "Tutti i documenti")}</a>
              <a href={localizedHref(locale, "/legal/termini-e-condizioni")} class="text-foreground no-underline hover:text-accent">{label("termsConditions", "Termini e condizioni")}</a>
              <a href={localizedHref(locale, "/legal/privacy")} class="text-foreground no-underline hover:text-accent">{label("privacy", "Privacy")}</a>
              <a href={localizedHref(locale, "/legal/accessibilita")} class="text-foreground no-underline hover:text-accent">{label("accessibility", "Accessibilità")}</a>
              <a href={localizedHref(locale, "/legal/cookie-policy")} class="text-foreground no-underline hover:text-accent">{label("cookie", "Cookie")}</a>
              <a href={localizedHref(locale, "/impressum")} class="text-foreground no-underline hover:text-accent">{label("legalNotice", "Avviso legale")}</a>
            </nav>
          </div>
          <div>
            <p class="eyebrow">{label("contacts", "Contatti")}</p>
            <div class="mt-4 flex flex-col gap-2">
              <a href={`mailto:${info.email}`} class="text-foreground no-underline hover:text-accent">{info.email}</a>
              <a href={`tel:${info.phone.replace(/[^\d+]/g, "")}`} class="text-foreground no-underline hover:text-accent">{info.phone}</a>
              <a href="tel:+436767517274" class="text-foreground no-underline hover:text-accent">+43 676 751 7274 (Austria)</a>
              <p class="text-muted-foreground">{info.address}</p>
            </div>
          </div>
          <div>
            <p class="eyebrow">{label("followLabel", "Segui")}</p>
            <div class="mt-4 flex flex-col gap-2">
              <a href="https://www.instagram.com/stefanolunardiphoto" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">{label("socialInstagram", "Instagram")}</a>
              <a href="https://www.facebook.com/StefanoLunardiFotografo" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">{label("socialFacebook", "Facebook")}</a>
              <a href="https://www.linkedin.com/in/stefano-lunardi-5b761526" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">{label("socialLinkedIn", "LinkedIn")}</a>
              <a href="https://www.youtube.com/@stefanolunardiphotographer7802/videos" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">{label("socialYouTube", "YouTube")}</a>
              <a href="https://www.singulart.com/it/artista/stefano-lunardi-37102" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">Singulart — opere fine art</a>
              <a href="https://www.matrimonio.com/fotografo-matrimonio/stefanolunardi-photographer--e33485/opinioni" target="_blank" rel="noopener" class="text-foreground no-underline hover:text-accent">Matrimonio.com — opinioni</a>
            </div>
          </div>
        </div>
        <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row">
          <p>{copyright}</p>
          <div class="flex items-center gap-4">
            <button type="button" data-consent-settings class="no-underline hover:text-accent">
              {label("cookiePreferences", "Preferenze cookie")}
            </button>
            <a href={localizedHref(locale, "/impressum")} class="no-underline hover:text-accent">{label("legalNotice", "Avviso legale")}</a>
          </div>
        </div>
      </div>
    </footer>
    <ConsentBanner labels={labels} />
    <script>
      import { mountRipple } from "@/shared/ripple";
      import { mountSmoothScroll } from "@/shared/smooth-scroll";

      const locales = ["it", "es", "en", "de"];
      const locale = document.documentElement.lang.split("-")[0] || "it";
      if (locales.includes(locale)) {
        const localizeLinks = () => {
          document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((anchor) => {
            const currentHref = anchor.getAttribute("href");
            if (!currentHref || !currentHref.startsWith("/")) return;
            const firstSegment = currentHref.slice(1).split(/[/?#]/)[0];
            if (locales.includes(firstSegment)) return;
            anchor.setAttribute("href", currentHref === "/" ? `/${locale}/` : `/${locale}${currentHref}`);
          });
        };
        localizeLinks();
        new MutationObserver(localizeLinks).observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      mountRipple();
      mountSmoothScroll();
    </script>
  </body>
</html>
