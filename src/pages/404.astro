---
import "@/styles/global.css";
import SiteHeader from "@/app/header.astro";
import { allNav, primaryNav } from "@/app/nav";
import tidalPhoto from "@/assets/photos/01-autentiche.webp";
import TidalLens from "@/features/tidal-lens/tidal-lens.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>404 — Pagina non trovata | Stefano Lunardi</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-foreground">
    <SiteHeader navPrimary={primaryNav} navAll={allNav} current={currentPath} />
    <TidalLens src={tidalPhoto} />
  </body>
</html>
