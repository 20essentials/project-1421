---
import SiteLayout from "@/app/layout.astro";
import PhotoGrid from "@/features/home/photo-grid.astro";
import ArtisticParallax from "@/features/home/artistic-parallax.astro";
import { fetchPosts, postMetaLine, postPath } from "@/features/blog/posts";
import { fetchFaq } from "@/features/faq/faq";
import { getSitePageContent } from "@/features/site-content/site-content";
import { imgAttrs, imgSrc, imgSrcSet } from "@/shared/media";
import type { PostPage } from "@/features/blog/types";
import type { FaqData } from "@/features/faq/types";

let posts: PostPage | undefined;
let faq: FaqData = { categories: [], questions: [], truncated: false };
try {
  [posts, faq] = await Promise.all([fetchPosts(), fetchFaq()]);
} catch {
}

const heroContent = await getSitePageContent("home");

// Hero photograph, uploaded to the site's Media Manager (new-hero.avif, 2752×1536).
const HERO_IMAGE = "wix:image://v1/600582_d3da93d4d8584fd282a085b093fc7b9d~mv2.avif/new-hero.jpg#originWidth=2752&originHeight=1536";
const HERO_RATIO = 1536 / 2752;
// Art gallery photograph (IMG_7285), uploaded to the site's Media Manager (slide-art-gallery.avif, 4032×3024).
const ART_GALLERY_IMAGE = "wix:image://v1/600582_52669cad776f4a7e9c9b14d257a2da13~mv2.avif/slide-art-gallery.avif#originWidth=4032&originHeight=3024";
const ART_GALLERY_RATIO = 3024 / 4032;
// Black & white couple walking (04_veil), uploaded to the site's Media Manager (slide-veil-bw.avif, 4961×3425).
const VEIL_IMAGE = "wix:image://v1/600582_d6196421a6164916a081fe5ffd20de27~mv2.avif/slide-veil-bw.avif#originWidth=4961&originHeight=3425";
const VEIL_RATIO = 3425 / 4961;
const faqPreview = faq.questions.slice(0, 3);
const latestPosts = posts?.posts.slice(0, 3) ?? [];
const INTRO_VIDEO_ID = "5gY0HgkSVjU";

interface ScrollScene {
  key: string;
  imageUrl: string;
  ratio: number;
  alt: string;
  secondaryImageUrl?: string;
  secondaryAlt?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  href?: string;
  cta?: string;
  secondaryHref?: string;
  secondaryCta?: string;
  solid?: boolean;
  heading?: "h1" | "h2";
}

// Three full-viewport scenes: the hero (two images), an art-gallery photograph
// (Stefano is also an art photographer), and a fine-art wedding photograph.
const heroScene: ScrollScene = {
  key: "hero",
  imageUrl: HERO_IMAGE,
  ratio: HERO_RATIO,
  alt: "Fotografia di matrimonio fine art — Stefano Lunardi",
  secondaryImageUrl: "https://static.wixstatic.com/media/600582_29f0dfe738694177b687ea3b4af8dcbb~mv2.avif",
  secondaryAlt: "Fotografia d'arte — Stefano Lunardi",
  eyebrow: heroContent.eyebrow,
  title: heroContent.title,
  description: heroContent.intro,
  href: "/contatti",
  cta: "Raccontami la vostra storia",
  secondaryHref: "/portfolio",
  secondaryCta: "Guarda il portfolio",
  solid: true,
  heading: "h1",
};

const artScene: ScrollScene = {
  key: "art-gallery",
  imageUrl: ART_GALLERY_IMAGE,
  ratio: ART_GALLERY_RATIO,
  alt: "Fotografia d'arte — opera esposta in galleria, Stefano Lunardi",
  eyebrow: "Fotografia d'arte",
  title: "Non solo matrimoni: anche arte",
  description: "Le opere di Stefano sono esposte e acquistabili su Singulart. Luce, composizione, atmosfera: la stessa ricerca entra in ogni scatto.",
  href: "/fine-art",
  cta: "Scopri le opere",
  heading: "h2",
};

const veilScene: ScrollScene = {
  key: "fine-art-wedding",
  imageUrl: VEIL_IMAGE,
  ratio: VEIL_RATIO,
  alt: "Coppia in bianco e nero che cammina — fotografia fine art di matrimonio, Stefano Lunardi",
  eyebrow: "Fine Art Wedding",
  title: "Matrimoni come opere d'arte",
  description: "Ogni scatto è un quadro: la stessa visione delle opere fine art, portata nel vostro giorno.",
  href: "/portfolio",
  cta: "Guarda il portfolio",
  heading: "h2",
};

const scenes: ScrollScene[] = [heroScene, artScene, veilScene];

const alignFor = (i: number): "center" | "right" | "left" =>
  i === 0 ? "center" : i % 2 === 1 ? "right" : "left";
---

<SiteLayout title={heroContent.title} description={heroContent.intro}>
  <section data-scroll-world data-bleed class="sw-root">
    <div class="sw-viewport">
      {scenes.map((s, i) => (
        <div class="sw-scene">
          <div class="sw-still" class:list={{ "sw-still--split": !!s.secondaryImageUrl }}>
            <img
              src={imgSrc(s.imageUrl, 1280, Math.round(1280 * s.ratio))}
              srcset={imgSrcSet(s.imageUrl, [640, 960, 1280, 1600, 2000, 2560], s.ratio)}
              sizes={s.secondaryImageUrl ? "50vw" : "100vw"}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
              alt={s.alt}
              class="sw-still__img"
            />
            {s.secondaryImageUrl && (
              <img
                src={s.secondaryImageUrl}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
                alt={s.secondaryAlt ?? s.alt}
                class="sw-still__img"
              />
            )}
          </div>
          {s.title && (
            <>
              <div class="sw-scrim" data-align={alignFor(i)}></div>
              <div class="sw-copy" data-align={alignFor(i)}>
                {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
                {s.heading === "h1" ? (
                  <h1 class="font-display mt-3 max-w-3xl break-words text-4xl font-medium leading-tight text-primary-foreground sm:text-5xl md:text-6xl">{s.title}</h1>
                ) : (
                  <h2 class="font-display mt-3 max-w-2xl break-words text-4xl font-medium text-primary-foreground sm:text-5xl">{s.title}</h2>
                )}
                {s.description && <p class="mt-4 max-w-xl text-sm leading-relaxed text-primary-foreground/85 sm:text-base">{s.description}</p>}
                {s.href && s.cta && (
                  <div class="sw-ctas mt-6 flex flex-col gap-3 sm:flex-row">
                    <a
                      href={s.href}
                      class:list={[
                        "rounded-control px-8 py-3 text-sm font-medium no-underline transition-colors",
                        s.solid
                          ? "bg-primary-foreground text-foreground hover:bg-accent hover:text-accent-foreground"
                          : "border border-primary-foreground/60 text-primary-foreground hover:border-primary-foreground hover:bg-primary-foreground/10",
                      ]}
                    >{s.cta}</a>
                    {s.secondaryHref && (
                      <a href={s.secondaryHref} class="rounded-control border border-primary-foreground/60 px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-primary-foreground hover:bg-primary-foreground/10">{s.secondaryCta}</a>
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <section id="chi-e-stefano" class="border-y border-border bg-secondary px-6 py-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-[2fr_3fr] md:gap-16">
      <figure class="relative">
        <img
          src="https://static.wixstatic.com/media/600582_4f4ec030097f4d19b03ee08e8c2b7c1c~mv2.jpg"
          alt="Stefano Lunardi, fotografo di matrimoni fine art, con la sua macchina fotografica"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 w-full bg-background object-cover object-top"
        />
      </figure>
      <div>
        <h2 class="font-display text-4xl font-medium sm:text-5xl">Stefano Lunardi</h2>
        <p class="mt-5 text-lg font-medium leading-relaxed text-foreground">
          Fotografo con oltre trent'anni di esperienza: fotogiornalista per le maggiori testate italiane, artista fine art premiato in tutto il mondo, fotografo di matrimoni dal 2012.
        </p>
        <div class="mt-5 flex flex-col gap-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          <p>
            Quindici anni di fotogiornalismo gli hanno insegnato a leggere una scena prima che accada e a diventare invisibile. La ricerca delle opere d'arte — luce, composizione, atmosfera, oltre 100 premi internazionali e qualifica QEP — gli ha dato la visione. Dal 2012 unisce i due mondi in un unico metodo, portato nei matrimoni tra Italia e Austria.
          </p>
          <p>
            Le sue opere sono esposte e acquistabili su Singulart. Vive tra Italia e Austria e parla italiano, tedesco e inglese: parlare con tutti gli ospiti nella loro lingua cambia le fotografie.
          </p>
        </div>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/chi-sono" class="rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Scopri la sua storia</a>
          <a href="/awards" class="rounded-control btn-ghost no-underline">Premi e riconoscimenti</a>
        </div>
      </div>
    </div>
  </section>

  <section id="arte" class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="eyebrow">Fotografia artistica</p>
        <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">Oltre i matrimoni: le opere</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-muted-foreground">
          Ogni scatto nasce dalla stessa ricerca delle opere d'arte — luce, composizione, atmosfera.
          Il lavoro personale di Stefano è esposto e acquistabile nelle gallerie online.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <a
          href="https://www.singulart.com/it/artista/stefano-lunardi-37102"
          target="_blank"
          rel="noopener"
          class="fa-card group block no-underline"
        >
          <span class="fa-card__logo-box">
            <img
              src="https://static.wixstatic.com/media/600582_69556f102c7c4109b35799dda4f34a70~mv2.png"
              alt="Singulart"
              loading="lazy"
              decoding="async"
              class="fa-card__logo fa-card__logo--wide"
            />
          </span>
          <h3 class="font-display fa-card__title">Singulart</h3>
          <p class="fa-card__label">Opere originali esposte e acquistabili</p>
          <span class="fa-card__cta">Visita la pagina dell'artista →</span>
        </a>
        <a
          href="https://www.artlunagallery.com/fine-art-portrait"
          target="_blank"
          rel="noopener"
          class="fa-card group block no-underline"
        >
          <span class="fa-card__logo-box">
            <img
              src="https://static.wixstatic.com/media/600582_eb36bc46a1c240ea8c4629a013cdb253~mv2.avif"
              alt="LunaGallery"
              loading="lazy"
              decoding="async"
              class="fa-card__logo fa-card__logo--square"
            />
          </span>
          <h3 class="font-display fa-card__title">LunaGallery</h3>
          <p class="fa-card__label">Fine art portrait in edizione limitata</p>
          <span class="fa-card__cta">Esplora LunaGallery →</span>
        </a>
      </div>
    </div>
  </section>

  <section id="mi-presento" class="mp-root px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="eyebrow mp-eyebrow">Mi presento</p>
        <h2 class="font-display mp-heading mt-4 break-words text-4xl font-medium leading-tight sm:text-5xl">Un volto, una voce, un metodo</h2>
        <p class="mp-copy mx-auto mt-5 max-w-2xl text-sm leading-relaxed sm:text-base">
          Prima dei premi e delle fotografie, c'è una persona. In questo minuto vi racconto chi sono
          e come guardo un giorno di matrimonio — senza filtri, come con il rullino.
        </p>
      </div>
      <div class="mp-frame relative mt-12">
        <lite-youtube
          videoid={INTRO_VIDEO_ID}
          videoTitle="Mi presento — Stefano Lunardi"
          playlabel="Riproduci: Mi presento — Stefano Lunardi"
          params="rel=0"
          class="mp-video"
        />
        <p class="mp-frame__caption font-display text-sm italic sm:text-base">
          «Un minuto per conoscervi, una giornata per raccontarvi.»
        </p>
      </div>
      <div class="mt-10 text-center">
        <a href="/video" class="mp-link text-sm underline-offset-4 hover:underline no-underline">Guarda i wedding film e i reel</a>
      </div>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-3xl font-medium leading-snug sm:text-4xl">
        "Ti hanno detto che deve essere il giorno più bello della tua vita. Nessuno ti ha detto che deve essere il tuo."
      </p>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Esiste un'altra strada. Più lenta. Più rara. Più umana. Una fotografia che si prende il tempo di conoscerti prima di fotografarti, che consegna cento immagini straordinarie invece di mille dimenticabili, che tratta il matrimonio per quello che è: un'opera d'arte.
      </p>
      <p class="font-display mt-6 text-xl italic text-accent">Benvenuto nella tua storia.</p>
    </div>
  </section>

  <PhotoGrid />

  <ArtisticParallax />

  <section class="border-y border-border bg-secondary px-6 py-20">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 md:grid-cols-3">
      <div>
        <p class="eyebrow">La foto iconica naturale</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Non forzata, non posata, ma tecnicamente perfetta: il soggetto nella luce giusta — e non lo sa.</p>
      </div>
      <div>
        <p class="eyebrow">La candid foto</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Interazione vera — una risata, un abbraccio, uno sguardo — impostata a livello tecnico.</p>
      </div>
      <div>
        <p class="eyebrow">Lo snapshot</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Catturato in real-time senza alcun intervento: il livello più intimo.</p>
      </div>
      <a href="/il-mio-metodo" class="md:col-span-3 justify-self-center rounded-control btn-ghost no-underline">Scopri il Metodo Fusion</a>
    </div>
  </section>

  <section id="foto-e-video" class="fv-root px-6 py-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-[3fr_4fr] md:gap-16">
      <div>
        <p class="eyebrow fv-eyebrow">L'opera in divenire</p>
        <h2 class="font-display fv-heading mt-3 text-3xl font-medium leading-tight sm:text-4xl">
          La tela si dipinge, l'obbiettivo <em class="font-light italic">racconta</em>
        </h2>
        <p class="fv-copy mt-5 leading-relaxed">
          A volte la macchina da presa si punta su di me: registro la nascita delle mie opere,
          dalla prima pennellata all'ultima luce. Lo stesso sguardo che segue un matrimonio
          guarda anche la tela.
        </p>
        <a href="/video" class="fv-cta mt-8 inline-block no-underline">Guarda i wedding film e i reel →</a>
      </div>
      <figure class="fv-frame">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="https://static.wixstatic.com/media/600582_7aee14ecf9714020be28dcff3d7a17a2~mv2.avif"
          aria-label="Clip in loop: Stefano dipinge e registra la nascita di una sua opera"
          class="fv-video"
        >
          <source src="https://video.wixstatic.com/video/600582_ebf55de548bd485d860b78ad136c87e4/file" type="video/mp4" />
        </video>
        <figcaption class="fv-frame__caption font-display text-sm italic sm:text-base">
          «Ogni opera nasce dallo stesso sguardo.»
        </figcaption>
      </figure>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="px-6 pb-20 pt-20">
        <div class="mx-auto max-w-7xl">
          <div class="mb-10 flex flex-col items-end justify-between gap-4 sm:flex-row">
            <div>
              <p class="eyebrow text-muted-foreground">Ultime storie</p>
              <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">Dietro l'obiettivo</h2>
            </div>
            <a href="/blog" class="rounded-control btn-ghost no-underline">Tutti gli articoli</a>
          </div>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
            {latestPosts.map((p) => (
              <a href={postPath(p.slug)} class="group block min-w-0 no-underline">
                <div class="aspect-4/3 w-full overflow-hidden bg-secondary">
                  {p.coverUrl && (
                    <img {...imgAttrs(p.coverUrl, "(min-width: 640px) 33vw, 100vw", 4 / 3)} alt={p.coverAlt} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-103" />
                  )}
                </div>
                <h3 class="font-display mt-4 break-words text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-accent">{p.title}</h3>
                {postMetaLine(p) && (
                  <time datetime={p.dateISO} class="eyebrow mt-2 block">
                    {postMetaLine(p)}
                  </time>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-y border-border px-6 py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">Riconoscimenti</p>
      <p class="font-display mt-3 text-3xl font-medium sm:text-4xl">Oltre 100 premi internazionali</p>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">IPA International Photo Awards · International Color Awards · B&W Spider Awards · MIFA Moscow · WPGA · ANFM · Qualifica QEP</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        <img src="https://static.wixstatic.com/media/600582_c6b21435075c4f75a2e85ae788bd40f8~mv2.png" alt="Vogue Sposa" loading="lazy" decoding="async" class="h-12 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_ddc10a9178a043be98339105c08ea8d5~mv2.png" alt="Wezoree" loading="lazy" decoding="async" class="h-10 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_02a8c1efe51347b6b7f588636d848557~mv2.png" alt="IPA International Photo Awards — 1° place Fine Art 2016" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_fbdd14dd878d401890627eb7f701cd66~mv2.png" alt="MIFA Moscow International Foto Awards" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_3bc5573e9969414b839d337d95269b6f~mv2.png" alt="International Color Awards" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_0334b4cb9a1b4846963c5c3631d83b47~mv2.png" alt="IPA International Photo Awards — 2° place Wedding 2016" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
      </div>
      <a href="/awards" class="mt-8 rounded-control btn-ghost no-underline">Tutti i premi e le mostre</a>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <blockquote class="border-l-2 border-accent pl-6 text-left">
        <p class="font-display text-2xl italic leading-snug">"Ma chi era il fotografo? Non l'abbiamo nemmeno notato, eppure le foto sono incredibili."</p>
        <p class="mt-3 text-xs uppercase tracking-widest text-muted-foreground">Gli ospiti, a ogni matrimonio</p>
      </blockquote>
      <a href="/recensioni" class="mt-6 rounded-control btn-ghost no-underline">Leggi le recensioni delle coppie</a>
    </div>
  </section>

  {
    faqPreview.length > 0 && (
      <section class="border-y border-border bg-secondary px-6 py-24">
        <div class="mx-auto max-w-3xl">
          <div class="text-center">
            <p class="eyebrow text-muted-foreground">FAQ</p>
            <h2 class="font-display mt-3 text-3xl font-medium tracking-tight sm:text-4xl">Domande frequenti</h2>
          </div>
          <dl class="mt-14 border-b border-border">
            {faqPreview.map((q) => (
              <div class="group border-t border-border py-7">
                <dt class="font-display text-lg font-medium leading-snug tracking-tight text-foreground sm:text-xl">{q.question}</dt>
                <dd class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-muted-foreground">{q.answerText}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-12 text-center">
            <a href="/faq" class="rounded-control border border-foreground px-8 py-3 text-sm font-medium no-underline transition-colors hover:bg-foreground hover:text-primary-foreground">Tutte le domande e le risposte</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="px-6 py-24 text-center">
    <p class="eyebrow">Heart to Heart</p>
    <h2 class="font-display mx-auto mt-4 max-w-3xl text-4xl font-medium leading-tight sm:text-5xl">Quando sarete pronti, basterà un messaggio</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">Risposta entro 48 ore. Nessuna fretta, nessuna pressione: solo una conversazione sulla vostra storia.</p>
    <a href="/contatti" class="mt-8 inline-block rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Conosci Stefano</a>
  </section>
</SiteLayout>

<script>
  import "@justinribeiro/lite-youtube";
</script>

<script>
  import { mountScrollWorld } from "@/features/home/scroll-world";
  mountScrollWorld();
</script>

<style>
  /* Sin JS o con reduced-motion: escenas apiladas en flujo, una por viewport. */
  .sw-scene {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-secondary, #f5f1ea);
  }
  .sw-still {
    position: absolute;
    inset: 0;
  }
  .sw-still__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .sw-still--split {
    display: flex;
  }
  .sw-still--split .sw-still__img {
