---
import SiteLayout from "@/app/layout.astro";
import PhotoGrid from "@/features/home/photo-grid.astro";
import ArtisticParallax from "@/features/home/artistic-parallax.astro";
import { fetchPosts, postMetaLine, postPath } from "@/features/blog/posts";
import { fetchFaq } from "@/features/faq/faq";
import { getHomeContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";
import { imgAttrs, imgSrc, imgSrcSet, mediaKey } from "@/shared/media";
import { homeExtraSeals } from "@/shared/award-seals";
import type { PostPage } from "@/features/blog/types";
import type { FaqData } from "@/features/faq/types";

let posts: PostPage | undefined;
let faq: FaqData = { categories: [], questions: [], truncated: false };
const locale = currentLocale(Astro.url, Astro.request.headers);
const href = (path: string) => localizedHref(locale, path);
try {
  [posts, faq] = await Promise.all([
    fetchPosts({ headers: Astro.request.headers, locale }),
    fetchFaq(Astro.request.headers),
  ]);
} catch {
}

const heroContent = await getHomeContent(Astro.request.headers);

// Slide aspect ratios (height/width) — layout facts; the CMS supplies the images themselves.
const HERO_RATIO = 1536 / 2752;
const ART_GALLERY_RATIO = 3024 / 4032;
const VEIL_RATIO = 3425 / 4961;

const faqPreview = faq.questions.slice(0, 3);
const latestPosts = posts?.posts.slice(0, 3) ?? [];

const homeAwardLogos = [
  { src: heroContent.awardLogo1, alt: "Vogue Sposa", label: "Vogue Sposa", width: 600, height: 600 },
  { src: heroContent.awardLogo2, alt: "Wezoree", label: "Wezoree", width: 5552, height: 1700 },
  { src: heroContent.awardLogo3, alt: "IPA International Photo Awards — 1° place Fine Art 2016", label: "IPA International Photo Awards", width: 800, height: 790 },
  { src: heroContent.awardLogo4, alt: "MIFA Moscow International Foto Awards", label: "MIFA Moscow", width: 702, height: 702 },
  { src: heroContent.awardLogo5, alt: "International Color Awards", label: "International Color Awards", width: 250, height: 251 },
  { src: heroContent.awardLogo6, alt: "IPA International Photo Awards — 2° place Wedding 2016", label: "IPA International Photo Awards", width: 800, height: 790 },
];

interface ScrollScene {
  key: string;
  imageUrl: string;
  ratio: number;
  alt: string;
  secondaryImageUrl?: string;
  secondaryAlt?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  href?: string;
  cta?: string;
  secondaryHref?: string;
  secondaryCta?: string;
  solid?: boolean;
  heading?: "h1" | "h2";
}

// Three full-viewport scenes: the hero (two images), an art-gallery photograph
// (Stefano is also an art photographer), and a fine-art wedding photograph.
const heroScene: ScrollScene = {
  key: "hero",
  imageUrl: heroContent.heroImage,
  ratio: HERO_RATIO,
  alt: "Fotografia di matrimonio fine art — Stefano Lunardi",
  secondaryImageUrl: heroContent.heroImage2,
  secondaryAlt: "Fotografia d'arte — Stefano Lunardi",
  eyebrow: heroContent.eyebrow,
  title: heroContent.title,
  description: heroContent.intro,
  href: href("/contatti"),
  cta: heroContent.heroCta,
  secondaryHref: href("/portfolio"),
  secondaryCta: heroContent.heroCta2,
  solid: true,
  heading: "h1",
};

const artScene: ScrollScene = {
  key: "art-gallery",
  imageUrl: heroContent.slide2Image,
  ratio: ART_GALLERY_RATIO,
  alt: "Fotografia d'arte — opera esposta in galleria, Stefano Lunardi",
  eyebrow: heroContent.slide2Eyebrow,
  title: heroContent.slide2Title,
  description: heroContent.slide2Intro,
  href: href("/fine-art"),
  cta: heroContent.slide2Cta,
  heading: "h2",
};

const veilScene: ScrollScene = {
  key: "fine-art-wedding",
  imageUrl: heroContent.slide3Image,
  ratio: VEIL_RATIO,
  alt: "Coppia in bianco e nero che cammina — fotografia fine art di matrimonio, Stefano Lunardi",
  eyebrow: heroContent.slide3Eyebrow,
  title: heroContent.slide3Title,
  description: heroContent.slide3Intro,
  href: href("/portfolio"),
  cta: heroContent.slide3Cta,
  heading: "h2",
};

const scenes: ScrollScene[] = [heroScene, artScene, veilScene];

const alignFor = (i: number): "center" | "right" | "left" =>
  i === 0 ? "center" : i % 2 === 1 ? "right" : "left";
---

<SiteLayout title={heroContent.title} description={heroContent.intro}>
  <section data-scroll-world data-bleed class="sw-root">
    <div class="sw-viewport">
      {scenes.map((s, i) => (
        <div class="sw-scene">
          <div class="sw-still" class:list={{ "sw-still--split": !!s.secondaryImageUrl }}>
            <img
              src={imgSrc(s.imageUrl, 1280, Math.round(1280 * s.ratio))}
              srcset={imgSrcSet(s.imageUrl, [640, 960, 1280, 1600, 2000, 2560], s.ratio)}
              sizes={s.secondaryImageUrl ? "50vw" : "100vw"}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
              alt={s.alt}
              width={1600}
              height={Math.round(1600 * s.ratio)}
              class="sw-still__img"
            />
            {s.secondaryImageUrl && (
              <img
                src={s.secondaryImageUrl}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
                alt={s.secondaryAlt ?? s.alt}
                width={1600}
                height={Math.round(1600 * s.ratio)}
                class="sw-still__img"
              />
            )}
          </div>
          {s.title && (
            <>
              <div class="sw-scrim" data-align={alignFor(i)}></div>
              <div class="sw-copy" data-align={alignFor(i)}>
                {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
                {s.heading === "h1" ? (
                  <h1 class="font-display mt-3 max-w-3xl break-words text-4xl font-medium leading-tight text-primary-foreground sm:text-5xl md:text-6xl">{s.title}</h1>
                ) : (
                  <h2 class="font-display mt-3 max-w-2xl break-words text-4xl font-medium text-primary-foreground sm:text-5xl">{s.title}</h2>
                )}
                {s.description && <p class="mt-4 max-w-xl text-sm leading-relaxed text-primary-foreground/85 sm:text-base">{s.description}</p>}
                {s.href && s.cta && (
                  <div class="sw-ctas mt-6 flex flex-col gap-3 sm:flex-row">
                    <a
                      href={s.href}
                      class:list={[
                        "rounded-control px-8 py-3 text-sm font-medium no-underline transition-colors",
                        s.solid
                          ? "bg-primary-foreground text-foreground hover:bg-accent hover:text-accent-foreground"
                          : "border border-primary-foreground/60 text-primary-foreground hover:border-primary-foreground hover:bg-primary-foreground/10",
                      ]}
                    >{s.cta}</a>
                    {s.secondaryHref && (
                      <a href={s.secondaryHref} class="rounded-control border border-primary-foreground/60 px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-primary-foreground hover:bg-primary-foreground/10">{s.secondaryCta}</a>
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <section id="chi-e-stefano" class="border-y border-border bg-secondary px-6 py-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-[2fr_3fr] md:gap-16">
      <figure class="relative">
        <img
          src={imgSrc(heroContent.aboutImage, 640, 800)}
          alt="Stefano Lunardi, fotografo di matrimoni fine art, con la sua macchina fotografica"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 w-full bg-background object-cover object-top"
          width="640"
          height="800"
        />
      </figure>
      <div>
        <h2 class="font-display text-4xl font-medium sm:text-5xl">Stefano Lunardi</h2>
        <p class="mt-5 text-lg font-medium leading-relaxed text-foreground">
          {heroContent.aboutIntro}
        </p>
        <div class="mt-5 flex flex-col gap-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          <p>{heroContent.aboutText1}</p>
          <p>{heroContent.aboutText2}</p>
        </div>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href={href("/chi-sono")} class="rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">{heroContent.aboutCta}</a>
          <a href={href("/awards")} class="rounded-control btn-ghost no-underline">{heroContent.aboutCta2}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="arte" class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="eyebrow">{heroContent.arteEyebrow}</p>
        <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">{heroContent.arteTitle}</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-muted-foreground">
          {heroContent.arteIntro}
        </p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <a
          href="https://www.singulart.com/it/artista/stefano-lunardi-37102"
          target="_blank"
          rel="noopener"
          class="fa-card group block no-underline"
        >
          <span class="fa-card__logo-box">
            <img
              src={`https://static.wixstatic.com/media/${mediaKey(heroContent.singulartLogo)}`}
              alt="Singulart"
              loading="lazy"
              decoding="async"
              class="fa-card__logo fa-card__logo--wide"
              style="aspect-ratio: 2222 / 393"
              width="2222"
              height="393"
            />
          </span>
          <h3 class="font-display fa-card__title">Singulart</h3>
          <p class="fa-card__label">{heroContent.arteSingulartLabel}</p>
          <span class="fa-card__cta">{heroContent.arteSingulartCta}</span>
        </a>
        <a
          href="https://www.artlunagallery.com/fine-art-portrait"
          target="_blank"
          rel="noopener"
          class="fa-card group block no-underline"
        >
          <span class="fa-card__logo-box">
            <img
              src={`https://static.wixstatic.com/media/${mediaKey(heroContent.lunagalleryLogo)}`}
              alt="LunaGallery"
              loading="lazy"
              decoding="async"
              class="fa-card__logo fa-card__logo--square"
              style="aspect-ratio: 2252 / 2126"
              width="2252"
              height="2126"
            />
          </span>
          <h3 class="font-display fa-card__title">LunaGallery</h3>
          <p class="fa-card__label">{heroContent.arteLunagalleryLabel}</p>
          <span class="fa-card__cta">{heroContent.arteLunagalleryCta}</span>
        </a>
      </div>
    </div>
  </section>

  <section id="mi-presento" class="mp-root relative h-svh min-h-[38rem] overflow-hidden">
    <lite-youtube
      videoid={heroContent.presentoVideoId}
      videoTitle="Mi presento — Stefano Lunardi"
      playlabel="Riproduci: Mi presento — Stefano Lunardi"
      params="rel=0"
      class="mp-media"
    >
      <img
        slot="image"
        src="https://static.wixstatic.com/media/600582_845da6b245d64d8a9fb152dcb8a9325c~mv2.avif"
        alt="Stefano Lunardi nel suo studio, anteprima del video Mi presento"
        loading="lazy"
        decoding="async"
        width="1280"
        height="720"
      />
    </lite-youtube>
    <div class="mp-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="mp-copy pointer-events-none absolute inset-x-0 bottom-0 z-10 flex flex-col items-start px-6 pb-8 sm:px-10 sm:pb-10">
      <p class="eyebrow mp-eyebrow">{heroContent.presentoEyebrow}</p>
      <h2 class="font-display mp-heading mt-3 break-words text-3xl font-medium leading-tight sm:text-5xl">{heroContent.presentoTitle}</h2>
      <p class="mp-copy-text mt-4 max-w-xl text-sm leading-relaxed sm:text-base">
        {heroContent.presentoIntro}
      </p>
      <a href={href("/video")} class="mp-link pointer-events-auto mt-6 no-underline">{heroContent.presentoLink}</a>
      <p class="mp-frame__caption font-display mt-5 text-sm italic sm:text-base">
        {heroContent.presentoCaption}
      </p>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-3xl font-medium leading-snug sm:text-4xl">
        {heroContent.manifestoQuote}
      </p>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        {heroContent.manifestoText}
      </p>
      <p class="font-display mt-6 text-xl italic text-accent">{heroContent.manifestoWelcome}</p>
    </div>
  </section>

  <PhotoGrid
    eyebrow={heroContent.gridEyebrow}
    title={heroContent.gridTitle}
    ctaLabel={heroContent.gridCta}
    ctaHref={href("/portfolio")}
  />

  <ArtisticParallax
    eyebrow={heroContent.parallaxEyebrow}
    title={heroContent.parallaxTitle}
    line={heroContent.parallaxLine}
    ctaHref={href("/fine-art")}
  />

  <section class="border-y border-border bg-secondary px-6 py-20">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 md:grid-cols-3">
      <div>
        <p class="eyebrow">{heroContent.shot1Eyebrow}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{heroContent.shot1Text}</p>
      </div>
      <div>
        <p class="eyebrow">{heroContent.shot2Eyebrow}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{heroContent.shot2Text}</p>
      </div>
      <div>
        <p class="eyebrow">{heroContent.shot3Eyebrow}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{heroContent.shot3Text}</p>
      </div>
      <a href={href("/il-mio-metodo")} class="md:col-span-3 justify-self-center rounded-control btn-ghost no-underline">{heroContent.shotsCta}</a>
    </div>
  </section>

  <section id="foto-e-video" class="fv-root px-6 py-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-[3fr_4fr] md:gap-16">
      <div>
        <p class="eyebrow fv-eyebrow">{heroContent.fvEyebrow}</p>
        <h2 class="font-display fv-heading mt-3 text-3xl font-medium leading-tight sm:text-4xl">
          {heroContent.fvTitle}
        </h2>
        <p class="fv-copy mt-5 leading-relaxed">
          {heroContent.fvText}
        </p>
        <a href={href("/video")} class="fv-cta mt-8 inline-block no-underline">{heroContent.fvCta}</a>
      </div>
      <figure class="fv-frame">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={imgSrc(heroContent.fvPoster, 1280, 720)}
          aria-label="Clip in loop: Stefano dipinge e registra la nascita di una sua opera"
          class="fv-video"
        >
          <source src={heroContent.fvVideoUrl} type="video/mp4" />
        </video>
        <figcaption class="fv-frame__caption font-display text-sm italic sm:text-base">
          {heroContent.fvCaption}
        </figcaption>
      </figure>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="px-6 pb-20 pt-20">
        <div class="mx-auto max-w-7xl">
          <div class="mb-10 flex flex-col items-end justify-between gap-4 sm:flex-row">
            <div>
              <p class="eyebrow text-muted-foreground">{heroContent.storiesEyebrow}</p>
              <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">{heroContent.storiesTitle}</h2>
            </div>
            <a href={href("/blog")} class="rounded-control btn-ghost no-underline">{heroContent.storiesCta}</a>
          </div>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
            {latestPosts.map((p) => (
              <a href={localizedHref(locale, postPath(p.slug))} class="group block min-w-0 no-underline">
                <div class="aspect-4/3 w-full overflow-hidden bg-secondary">
                  {p.coverUrl && (
                    <img {...imgAttrs(p.coverUrl, "(min-width: 640px) 33vw, 100vw", 4 / 3)} alt={p.coverAlt} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-103" />
                  )}
                </div>
                <h3 class="font-display mt-4 break-words text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-accent">{p.title}</h3>
                {postMetaLine(p) && (
                  <time datetime={p.dateISO} class="eyebrow mt-2 block">
                    {postMetaLine(p)}
                  </time>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section
    data-awards-wall
    aria-labelledby="awards-title"
    class="awards-wall dot-grid dot-grid-light border-y border-white/10 px-6 py-24 sm:py-32"
  >
    <div class="mx-auto max-w-7xl">
      <div class="awards-wall__head">
        <div>
          <p class="eyebrow awards-wall__eyebrow">{heroContent.awardsEyebrow}</p>
          <h2 id="awards-title" class="font-display awards-wall__title">{heroContent.awardsTitle}</h2>
          <p class="awards-wall__copy">{heroContent.awardsText}</p>
        </div>
        <p class="awards-wall__count" aria-hidden="true">100<span>+</span></p>
      </div>

      <ul class="awards-wall__grid">
        {
          homeAwardLogos.map((logo) => (
            <li class="awards-wall__card">
              <img
                src={`https://static.wixstatic.com/media/${mediaKey(logo.src)}`}
                alt={logo.alt}
                loading="lazy"
                decoding="async"
                class="awards-wall__img"
                width={logo.width}
                height={logo.height}
              />
              <span class="awards-wall__label" aria-hidden="true">{logo.label}</span>
            </li>
          ))
        }
        {
          homeExtraSeals.map((seal) => (
            <li class="awards-wall__card">
              <img
                src={seal.src}
                alt={seal.alt}
                loading="lazy"
                decoding="async"
                class="awards-wall__img"
                width={seal.width}
                height={seal.height}
              />
              <span class="awards-wall__label" aria-hidden="true">{seal.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="awards-wall__footer">
        <a href={href("/awards")} class="rounded-control awards-wall__cta">{heroContent.awardsCta}</a>
      </div>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <blockquote class="border-l-2 border-accent pl-6 text-left">
        <p class="font-display text-2xl italic leading-snug">{heroContent.quoteText}</p>
        <p class="mt-3 text-xs uppercase tracking-widest text-muted-foreground">{heroContent.quoteSource}</p>
      </blockquote>
      <a href={href("/recensioni")} class="mt-6 rounded-control btn-ghost no-underline">{heroContent.quoteCta}</a>
    </div>
  </section>

  {
    faqPreview.length > 0 && (
      <section class="border-y border-border bg-secondary px-6 py-24">
        <div class="mx-auto max-w-3xl">
          <div class="text-center">
            <p class="eyebrow text-muted-foreground">{heroContent.faqEyebrow}</p>
            <h2 class="font-display mt-3 text-3xl font-medium tracking-tight sm:text-4xl">{heroContent.faqTitle}</h2>
          </div>
          <dl class="mt-14 border-b border-border">
            {faqPreview.map((q) => (
              <div class="group border-t border-border py-7">
                <dt class="font-display text-lg font-medium leading-snug tracking-tight text-foreground sm:text-xl">{q.question}</dt>
                <dd class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-muted-foreground">{q.answerText}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-12 text-center">
              <a href={href("/faq")} class="rounded-control border border-foreground px-8 py-3 text-sm font-medium no-underline transition-colors hover:bg-foreground hover:text-primary-foreground">{heroContent.faqCta}</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="px-6 py-24 text-center">
    <p class="eyebrow">{heroContent.ctaEyebrow}</p>
    <h2 class="font-display mx-auto mt-4 max-w-3xl text-4xl font-medium leading-tight sm:text-5xl">{heroContent.ctaTitle}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{heroContent.ctaText}</p>
    <a href={href("/contatti")} class="mt-8 inline-block rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">{heroContent.ctaButton}</a>
  </section>
</SiteLayout>

<script>
  import "@justinribeiro/lite-youtube";

  const presento = document.getElementById("mi-presento");
  presento
    ?.querySelector("lite-youtube")
    ?.addEventListener("click", () => presento.setAttribute("data-playing", ""), { once: true });
</script>

<script>
  import { mountScrollWorld } from "@/features/home/scroll-world";
  mountScrollWorld();
</script>

<style>
  /* Sin JS o con reduced-motion: escenas apiladas en flujo, una por viewport. */
  .sw-scene {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-secondary, #f5f1ea);
  }
  .sw-still {
    position: absolute;
    inset: 0;
  }
  .sw-still__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .sw-still--split {
    display: flex;
  }
  .sw-still--split .sw-still__img {
    flex: none;
    width: 50%;
    transform-origin: right center;
  }
  .sw-still--split .sw-still__img + .sw-still__img {
    transform-origin: left center;
    border-left: 1px solid rgb(255 255 255 / 0.3);
  }
  @media (max-width: 767px) {
    .sw-still--split .sw-still__img:first-child {
      display: none;
    }
    .sw-still--split .sw-still__img {
      width: 100%;
    }
    .sw-still--split .sw-still__img + .sw-still__img {
      border-left: none;
    }
  }
  .sw-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.28) 55%, transparent 82%);
  }
  /* La máscara sigue al texto: esquina oscura y transparente hacia el lado opuesto. */
  @media (max-width: 767px) {
    .sw-scrim[data-align="right"],
    .sw-scrim[data-align="left"] {
      background: linear-gradient(to top right, rgb(0 0 0 / 0.92) 0%, rgb(0 0 0 / 0.68) 50%, transparent 92%);
