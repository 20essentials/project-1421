---
import SiteLayout from "@/app/layout.astro";
import PhotoGrid from "@/features/home/photo-grid.astro";
import PortfolioCoil from "@/features/home/portfolio-coil/portfolio-coil.astro";
import { fetchCollections, fetchProjects } from "@/features/portfolio/portfolio";
import { fetchPosts, postMetaLine, postPath } from "@/features/blog/posts";
import { fetchFaq } from "@/features/faq/faq";
import { imgAttrs, imgSrc, imgSrcSet } from "@/shared/media";
import type { CollectionSummary, ProjectSummary } from "@/features/portfolio/types";
import type { PostPage } from "@/features/blog/types";
import type { FaqData } from "@/features/faq/types";

let collections: CollectionSummary[] = [];
let projects: ProjectSummary[] = [];
let posts: PostPage | undefined;
let faq: FaqData = { categories: [], questions: [], truncated: false };
try {
  [collections, projects, posts, faq] = await Promise.all([fetchCollections(), fetchProjects(), fetchPosts(), fetchFaq()]);
} catch {
}

// Hero photograph, uploaded to the site's Media Manager (new-hero.jpg, 2752×1536).
const HERO_IMAGE = "wix:image://v1/600582_82bacbc4d7cd4b15b58a35079eca7781~mv2.jpg/new-hero.jpg#originWidth=2752&originHeight=1536";
const HERO_RATIO = 1536 / 2752;
// Colour interludes, uploaded to the site's Media Manager (new-color-2/3.jpg, 2752×1536).
const COLOR_IMAGE_2 = "wix:image://v1/600582_24a8227eaf6749d6bd0c8214523c187e~mv2.jpg/new-color-2.jpg#originWidth=2752&originHeight=1536";
const COLOR_IMAGE_3 = "wix:image://v1/600582_3d43c4c4c38544449dfc0e442eb6789f~mv2.jpg/new-color-3.jpg#originWidth=2752&originHeight=1536";
const COLOR_RATIO = 1536 / 2752;
const faqPreview = faq.questions.slice(0, 3);
const latestPosts = posts?.posts.slice(0, 3) ?? [];

interface ScrollScene {
  key: string;
  imageUrl: string;
  ratio: number;
  alt: string;
  secondaryImageUrl?: string;
  secondaryAlt?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  href?: string;
  cta?: string;
  secondaryHref?: string;
  secondaryCta?: string;
  solid?: boolean;
  heading?: "h1" | "h2";
}

// Five full-viewport scenes alternating colour and black & white: the hero
// photograph, a project, a colour interlude, another project, a colour interlude.
const MAX_SCENES = 5;
const PROJECT_SCENES = 4;
const collectionTitles = new Map(collections.map((c) => [c.id, c.title]));

const heroScene: ScrollScene = {
  key: "hero",
  imageUrl: HERO_IMAGE,
  ratio: HERO_RATIO,
  alt: "Fotografia di matrimonio fine art — Stefano Lunardi",
  secondaryImageUrl: "/stefan.jpg",
  secondaryAlt: "Fotografia d'arte — Stefano Lunardi",
  eyebrow: "Fotografo di matrimoni | Fine Art | Fotoreporter",
  title: "Matrimoni come opere d'arte, non come catene di montaggio",
  description: "Destination wedding tra Italia e Austria. Ogni scatto è un quadro d'arte.",
  href: "/contatti",
  cta: "Raccontami la vostra storia",
  secondaryHref: "/portfolio",
  secondaryCta: "Guarda il portfolio",
  solid: true,
  heading: "h1",
};

const projectScenes: ScrollScene[] = projects
  .filter((p) => p.imageUrl)
  .slice(0, PROJECT_SCENES)
  .map((p) => ({
    key: p.id,
    imageUrl: p.imageUrl,
    ratio: 2 / 3,
    alt: p.title,
    eyebrow: p.collectionIds.map((id) => collectionTitles.get(id)).find(Boolean) ?? "Progetto",
    title: p.title,
    description: p.description,
    href: `/projects/${p.slug}`,
    cta: "Vedi il progetto",
    heading: "h2",
  }));

const collectionScenes: ScrollScene[] = collections
  .filter((c) => c.imageUrl)
  .slice(0, PROJECT_SCENES)
  .map((c) => ({
    key: c.id,
    imageUrl: c.imageUrl,
    ratio: 2 / 3,
    alt: c.title,
    eyebrow: "Collezione",
    title: c.title,
    description: c.description,
    href: `/portfolio/${c.slug}`,
    cta: "Vedi la collezione",
    heading: "h2",
  }));

// Colour scenes carry their own editorial copy; the images alternate sides with the projects.
const colorInterludes: ScrollScene[] = [
  {
    key: "color-2",
    imageUrl: COLOR_IMAGE_2,
    ratio: COLOR_RATIO,
    alt: "Fotografia di matrimonio fine art a colori — Stefano Lunardi",
    eyebrow: "Slow photography",
    title: "La verità, senza filtri",
    description: "Con il rullino non esiste una versione ottimizzata: ogni fotogramma è una scelta deliberata, con la mente, con gli occhi, con il cuore.",
    href: "/il-mio-metodo",
    cta: "Scopri il metodo",
    heading: "h2",
  },
  {
    key: "color-3",
    imageUrl: COLOR_IMAGE_3,
    ratio: COLOR_RATIO,
    alt: "Fotografia di matrimonio fine art a colori — Stefano Lunardi",
    eyebrow: "Fine Art",
    title: "Ogni scena è un'opera",
    description: "La stessa ricerca delle opere fine art — luce, composizione, atmosfera — entra in ogni scatto del vostro matrimonio.",
    href: "/portfolio",
    cta: "Guarda il portfolio",
    heading: "h2",
  },
];

const bodyScenes = projectScenes.length >= 2 ? projectScenes : collectionScenes;
const scenes: ScrollScene[] = [heroScene];
let interlude = 0;
for (const scene of bodyScenes) {
  if (scenes.length >= MAX_SCENES) break;
  scenes.push(scene);
  if (interlude < colorInterludes.length && scenes.length < MAX_SCENES) {
    scenes.push(colorInterludes[interlude++]);
  }
}

const alignFor = (i: number): "center" | "right" | "left" =>
  i === 0 ? "center" : i % 2 === 1 ? "right" : "left";
---

<SiteLayout
  title="Stefano Lunardi — Fotografo di matrimoni | Fine Art | Fotoreporter"
  description="Matrimoni come opere d'arte, non come catene di montaggio. Destination wedding tra Italia e Austria: ogni scatto è un quadro d'arte."
>
  <section data-scroll-world data-bleed class="sw-root">
    <div class="sw-viewport">
      {scenes.map((s, i) => (
        <div class="sw-scene">
          <div class="sw-still" class:list={{ "sw-still--split": !!s.secondaryImageUrl }}>
            <img
              src={imgSrc(s.imageUrl, 1280, Math.round(1280 * s.ratio))}
              srcset={imgSrcSet(s.imageUrl, [640, 960, 1280, 1600, 2000, 2560], s.ratio)}
              sizes={s.secondaryImageUrl ? "50vw" : "100vw"}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
              alt={s.alt}
              class="sw-still__img"
            />
            {s.secondaryImageUrl && (
              <img
                src={s.secondaryImageUrl}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
                alt={s.secondaryAlt ?? s.alt}
                class="sw-still__img"
              />
            )}
          </div>
          {s.title && (
            <>
              <div class="sw-scrim" data-align={alignFor(i)}></div>
              <div class="sw-copy" data-align={alignFor(i)}>
                {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
                {s.heading === "h1" ? (
                  <h1 class="font-display mt-3 max-w-3xl break-words text-4xl font-medium leading-tight text-primary-foreground sm:text-5xl md:text-6xl">{s.title}</h1>
                ) : (
                  <h2 class="font-display mt-3 max-w-2xl break-words text-4xl font-medium text-primary-foreground sm:text-5xl">{s.title}</h2>
                )}
                {s.description && <p class="mt-4 max-w-xl text-sm leading-relaxed text-primary-foreground/85 sm:text-base">{s.description}</p>}
                {s.href && s.cta && (
                  <div class="sw-ctas mt-6 flex flex-col gap-3 sm:flex-row">
                    <a
                      href={s.href}
                      class:list={[
                        "rounded-control px-8 py-3 text-sm font-medium no-underline transition-colors",
                        s.solid
                          ? "bg-primary-foreground text-foreground hover:bg-accent hover:text-accent-foreground"
                          : "border border-primary-foreground/60 text-primary-foreground hover:border-primary-foreground hover:bg-primary-foreground/10",
                      ]}
                    >{s.cta}</a>
                    {s.secondaryHref && (
                      <a href={s.secondaryHref} class="rounded-control border border-primary-foreground/60 px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-primary-foreground hover:bg-primary-foreground/10">{s.secondaryCta}</a>
                    )}
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-3xl font-medium leading-snug sm:text-4xl">
        "Ti hanno detto che deve essere il giorno più bello della tua vita. Nessuno ti ha detto che deve essere il tuo."
      </p>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Esiste un'altra strada. Più lenta. Più rara. Più umana. Una fotografia che si prende il tempo di conoscerti prima di fotografarti, che consegna cento immagini straordinarie invece di mille dimenticabili, che tratta il matrimonio per quello che è: un'opera d'arte.
      </p>
      <p class="font-display mt-6 text-xl italic text-accent">Benvenuto nella tua storia.</p>
    </div>
  </section>

  <PhotoGrid />

  <PortfolioCoil />

  <section class="border-y border-border bg-secondary px-6 py-20">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 md:grid-cols-3">
      <div>
        <p class="eyebrow">La foto iconica naturale</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Non forzata, non posata, ma tecnicamente perfetta: il soggetto nella luce giusta — e non lo sa.</p>
      </div>
      <div>
        <p class="eyebrow">La candid foto</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Interazione vera — una risata, un abbraccio, uno sguardo — impostata a livello tecnico.</p>
      </div>
      <div>
        <p class="eyebrow">Lo snapshot</p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Catturato in real-time senza alcun intervento: il livello più intimo.</p>
      </div>
      <a href="/il-mio-metodo" class="md:col-span-3 text-center text-sm text-accent underline-offset-4 hover:underline no-underline">Scopri il Metodo Fusion</a>
    </div>
  </section>

  <section id="chi-e-stefano" class="border-y border-border bg-secondary px-6 py-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 md:grid-cols-[2fr_3fr] md:gap-16">
      <figure class="relative">
        <img
          src="/stefano/u1.jpg"
          alt="Stefano Lunardi, fotografo di matrimoni fine art, con la sua macchina fotografica"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full bg-background object-cover object-top"
        />
        <figcaption class="eyebrow mt-3 text-muted-foreground">Stefano Lunardi — fotografo</figcaption>
      </figure>
      <div>
        <img
          src="/stefano/logo.png"
          alt=""
          loading="lazy"
          decoding="async"
          class="invert mb-6 h-12 w-auto object-contain"
          aria-hidden="true"
        />
        <h2 class="font-display mt-3 text-4xl font-medium sm:text-5xl">Stefano Lunardi</h2>
        <p class="mt-5 text-lg font-medium leading-relaxed text-foreground">
          Fotografo con oltre trent'anni di esperienza: fotogiornalista per le maggiori testate italiane, artista fine art premiato in tutto il mondo, fotografo di matrimoni dal 2012.
        </p>
        <div class="mt-5 flex flex-col gap-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          <p>
            Quindici anni di fotogiornalismo gli hanno insegnato a leggere una scena prima che accada e a diventare invisibile. La ricerca delle opere d'arte — luce, composizione, atmosfera, oltre 100 premi internazionali e qualifica QEP — gli ha dato la visione. Dal 2012 unisce i due mondi in un unico metodo, portato nei matrimoni tra Italia e Austria.
          </p>
          <p>
            Le sue opere sono esposte e acquistabili presso Singulart e Luna Gallery. Vive tra Italia e Austria e parla italiano, tedesco e inglese: parlare con tutti gli ospiti nella loro lingua cambia le fotografie.
          </p>
        </div>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/chi-sono" class="rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Scopri la sua storia</a>
          <a href="/awards" class="text-sm text-accent underline-offset-4 hover:underline no-underline">Premi e riconoscimenti</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Foto e video</p>
      <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">Foto e video nascono dallo stesso sguardo</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">Un videomaker interno, stesso metodo: presenza discreta, nessuna messa in scena. Non due fornitori che si incontrano quel giorno.</p>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="px-6 pb-20">
        <div class="mx-auto max-w-7xl">
          <div class="mb-10 flex flex-col items-end justify-between gap-4 sm:flex-row">
            <h2 class="font-display text-3xl font-medium sm:text-4xl">Dietro l'obiettivo</h2>
            <a href="/blog" class="text-sm text-accent underline-offset-4 hover:underline no-underline">Tutti gli articoli</a>
          </div>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
            {latestPosts.map((p) => (
              <a href={postPath(p.slug)} class="group block min-w-0 no-underline">
                <div class="aspect-[4/3] w-full overflow-hidden bg-secondary">
                  {p.coverUrl && (
                    <img {...imgAttrs(p.coverUrl, "(min-width: 640px) 33vw, 100vw", 4 / 3)} alt={p.coverAlt} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
                  )}
                </div>
                <h3 class="font-display mt-4 break-words text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-accent">{p.title}</h3>
                {postMetaLine(p) && (
                  <time datetime={p.dateISO} class="eyebrow mt-2 block">
                    {postMetaLine(p)}
                  </time>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-y border-border px-6 py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">Riconoscimenti</p>
      <p class="font-display mt-3 text-3xl font-medium sm:text-4xl">Oltre 100 premi internazionali</p>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">IPA International Photo Awards · International Color Awards · B&W Spider Awards · MIFA Moscow · WPGA · ANFM · Qualifica QEP</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        <img src="https://static.wixstatic.com/media/600582_c6b21435075c4f75a2e85ae788bd40f8~mv2.png" alt="Vogue Sposa" loading="lazy" decoding="async" class="h-12 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_ddc10a9178a043be98339105c08ea8d5~mv2.png" alt="Wezoree" loading="lazy" decoding="async" class="h-10 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_02a8c1efe51347b6b7f588636d848557~mv2.png" alt="IPA International Photo Awards — 1° place Fine Art 2016" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_fbdd14dd878d401890627eb7f701cd66~mv2.png" alt="MIFA Moscow International Foto Awards" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_3bc5573e9969414b839d337d95269b6f~mv2.png" alt="International Color Awards" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
        <img src="https://static.wixstatic.com/media/600582_0334b4cb9a1b4846963c5c3631d83b47~mv2.png" alt="IPA International Photo Awards — 2° place Wedding 2016" loading="lazy" decoding="async" class="h-14 w-auto object-contain opacity-80" />
      </div>
      <a href="/awards" class="mt-8 inline-block text-sm text-accent underline-offset-4 hover:underline no-underline">Tutti i premi e le mostre</a>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <blockquote class="border-l-2 border-accent pl-6 text-left">
        <p class="font-display text-2xl italic leading-snug">"Ma chi era il fotografo? Non l'abbiamo nemmeno notato, eppure le foto sono incredibili."</p>
        <p class="mt-3 text-xs uppercase tracking-widest text-muted-foreground">Gli ospiti, a ogni matrimonio</p>
      </blockquote>
      <a href="/recensioni" class="mt-6 inline-block text-sm text-accent underline-offset-4 hover:underline no-underline">Leggi le recensioni delle coppie</a>
    </div>
  </section>

  {
    faqPreview.length > 0 && (
      <section class="border-y border-border bg-secondary px-6 py-20">
        <div class="mx-auto max-w-3xl">
          <div class="text-center">
            <p class="eyebrow">FAQ</p>
            <h2 class="font-display mt-3 text-3xl font-medium sm:text-4xl">Domande frequenti</h2>
          </div>
          <div class="mt-10 flex flex-col gap-6">
            {faqPreview.map((q) => (
              <div>
                <h3 class="font-medium text-foreground">{q.question}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{q.answerText}</p>
              </div>
            ))}
          </div>
          <div class="mt-10 text-center">
            <a href="/faq" class="text-sm text-accent underline-offset-4 hover:underline no-underline">Tutte le domande e le risposte</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="px-6 py-24 text-center">
    <p class="eyebrow">Heart to Heart</p>
    <h2 class="font-display mx-auto mt-4 max-w-3xl text-4xl font-medium leading-tight sm:text-5xl">Quando sarete pronti, basterà un messaggio</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">Risposta entro 48 ore. Nessuna fretta, nessuna pressione: solo una conversazione sulla vostra storia.</p>
    <a href="/contatti" class="mt-8 inline-block rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Conosci Stefano</a>
  </section>
</SiteLayout>

<script>
  import { mountScrollWorld } from "@/features/home/scroll-world";
  mountScrollWorld();
</script>

<style>
  /* Sin JS o con reduced-motion: escenas apiladas en flujo, una por viewport. */
  .sw-scene {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-secondary, #f5f1ea);
  }
  .sw-still {
    position: absolute;
    inset: 0;
  }
  .sw-still__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .sw-still--split {
    display: flex;
  }
  .sw-still--split .sw-still__img {
    flex: 0 0 50%;
    width: 50%;
  }
  .sw-still--split .sw-still__img + .sw-still__img {
    border-left: 1px solid rgb(255 255 255 / 0.3);
  }
  @media (max-width: 767px) {
    .sw-still--split .sw-still__img:first-child {
      display: none;
    }
    .sw-still--split .sw-still__img {
      flex: 0 0 100%;
      width: 100%;
    }
    .sw-still--split .sw-still__img + .sw-still__img {
      border-left: none;
    }
  }
  .sw-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.28) 55%, transparent 82%);
  }
  /* La máscara sigue al texto: esquina oscura y transparente hacia el lado opuesto. */
  @media (max-width: 767px) {
    .sw-scrim[data-align="right"],
    .sw-scrim[data-align="left"] {
      background: linear-gradient(to top right, rgb(0 0 0 / 0.92) 0%, rgb(0 0 0 / 0.68) 50%, transparent 92%);
    }
  }
  @media (min-width: 768px) {
    .sw-scrim[data-align="left"] {
      background: linear-gradient(to top right, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.45) 38%, transparent 72%);
    }
    .sw-scrim[data-align="right"] {
      background: linear-gradient(to top left, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.45) 38%, transparent 72%);
    }
  }
  .sw-copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 0 1.5rem 4.5rem;
    text-align: center;
    pointer-events: none;
  }
  .sw-copy .eyebrow {
    color: var(--color-primary-foreground);
  }
  .sw-ctas {
    align-items: center;
  }
  /* Sides en móvil: el hero queda centrado, las demás escenas a la izquierda. */
  @media (max-width: 767px) {
    .sw-copy[data-align="right"],
    .sw-copy[data-align="left"] {
      align-items: flex-start;
      text-align: left;
    }
    .sw-copy[data-align="right"] .sw-ctas,
    .sw-copy[data-align="left"] .sw-ctas {
      align-items: flex-start;
    }
  }
  /* Centro, derecha, izquierda, derecha, izquierda. */
  @media (min-width: 768px) {
    .sw-copy {
      padding-inline: clamp(2rem, 6vw, 6rem);
    }
    .sw-copy[data-align="right"] {
      align-items: flex-end;
      text-align: right;
    }
    .sw-copy[data-align="right"] .sw-ctas {
      align-items: flex-end;
    }
    .sw-copy[data-align="left"] {
      align-items: flex-start;
      text-align: left;
    }
    .sw-copy[data-align="left"] .sw-ctas {
      align-items: flex-start;
    }
  }
  .sw-copy a {
    pointer-events: auto;
  }

  /* Con JS: escenas absolutas en un viewport sticky; el alto del track lo fija el JS en px. */
  .sw-root[data-ready] .sw-viewport {
