---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";
import { awardSeals } from "@/shared/award-seals";
import "@/features/site-content/site-content.css";

const content = await getSitePageContent("awards", Astro.request.headers);
const locale = currentLocale(Astro.url, Astro.request.headers);
const fineArtHref = localizedHref(locale, "/fine-art");
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14">
    <h2 class="font-display text-3xl font-medium">I sigilli</h2>
    <div class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-5">
      {
        awardSeals.map((s) => (
          <div class="flex h-32 items-center justify-center border border-border bg-background p-3">
            <img src={s.src} alt={s.alt} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" width={s.width} height={s.height} style={`aspect-ratio: ${s.width} / ${s.height}`} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="site-content-body mx-auto max-w-3xl px-6 pb-14" set:html={content.bodyHtml} />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={fineArtHref} class="inline-block rounded-control border border-foreground px-8 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-accent hover:text-accent">Le opere fine art</a>
  </div>
</SiteLayout>
