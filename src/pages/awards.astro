---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";
import "@/features/site-content/site-content.css";

const seals = [
  { src: "https://static.wixstatic.com/media/600582_fba6dd2ca035494cb920338e825adfa2~mv2.jpg", alt: "Qualifica QEP — Qualified European Photographer", width: 1029, height: 1004 },
  { src: "https://static.wixstatic.com/media/600582_02a8c1efe51347b6b7f588636d848557~mv2.png", alt: "IPA International Photo Awards — winner seal", width: 800, height: 790 },
  { src: "https://static.wixstatic.com/media/600582_0334b4cb9a1b4846963c5c3631d83b47~mv2.png", alt: "IPA International Photo Awards — 2° place Wedding 2016", width: 800, height: 790 },
  { src: "https://static.wixstatic.com/media/600582_8a308e530faa45cfbcdf8ea49c438de9~mv2.png", alt: "IPA International Photo Awards — 3° place \"Black Heart\" 2020", width: 2000, height: 2061 },
  { src: "https://static.wixstatic.com/media/600582_bd28daabcca94357bd6e3a41e0d4ea3a~mv2.jpg", alt: "B&W Spider Awards — honorable mention", width: 483, height: 837 },
  { src: "https://static.wixstatic.com/media/600582_3bc5573e9969414b839d337d95269b6f~mv2.png", alt: "International Color Awards — winner 11th edizione", width: 250, height: 251 },
  { src: "https://static.wixstatic.com/media/600582_6b844f98f59f4792af43ce1483106b65~mv2.jpg", alt: "International Color Awards — Color Master nominee", width: 250, height: 245 },
  { src: "https://static.wixstatic.com/media/600582_fbdd14dd878d401890627eb7f701cd66~mv2.png", alt: "MIFA Moscow International Foto Awards — silver 2017", width: 702, height: 702 },
  { src: "https://static.wixstatic.com/media/600582_c44541e7e73d4a8aad75998536353639~mv2.png", alt: "WPGA — honorable mention 2016", width: 800, height: 300 },
  { src: "https://static.wixstatic.com/media/600582_e670259e22cb4eec80d2b88f434b4584~mv2.jpeg", alt: "La Grande Plaque", width: 360, height: 360 },
];

const content = await getSitePageContent("awards", Astro.request.headers);
const locale = currentLocale(Astro.url, Astro.request.headers);
const fineArtHref = localizedHref(locale, "/fine-art");
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14">
    <h2 class="font-display text-3xl font-medium">I sigilli</h2>
    <div class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-5">
      {
        seals.map((s) => (
          <div class="flex h-32 items-center justify-center border border-border bg-background p-3">
            <img src={s.src} alt={s.alt} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" width={s.width} height={s.height} style={`aspect-ratio: ${s.width} / ${s.height}`} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="site-content-body mx-auto max-w-3xl px-6 pb-14" set:html={content.bodyHtml} />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <a href={fineArtHref} class="inline-block rounded-control border border-foreground px-8 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-accent hover:text-accent">Le opere fine art</a>
  </div>
</SiteLayout>
