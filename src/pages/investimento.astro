---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";
import "@/features/site-content/site-content.css";

const content = await getSitePageContent("investimento", Astro.request.headers);
const locale = currentLocale(Astro.url, Astro.request.headers);
const contattiHref = localizedHref(locale, "/contatti");
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="site-content-body mx-auto max-w-3xl px-6 py-14" set:html={content.bodyHtml} />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <p class="font-display text-2xl italic">Quando sarete pronti, basterà un messaggio per bloccare la data</p>
    <a href={contattiHref} class="mt-6 inline-block rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Bloccare la data</a>
  </div>
</SiteLayout>
