---
// Post page.
//
// This is a Wix ITEM PAGE: the wixMetadata export + <SEO.Tags> below let the site owner edit
// this page's title/description/OG in the dashboard and register the route in the sitemap.
// Keep all three SEO pieces, the [...slug] rest param (a slug may contain "/"), and this
// frontmatter; restyle the template below freely. The body island is client:only — the ricos
// viewer breaks under SSR. The like row and the comments are client:load islands: both read as
// the VIEWER (personal like state, the member's own comments); the current member's id itself is
// resolved here and passed down, so the comments island never repeats that read client-side.
import SiteLayout from "@/app/layout.astro";
import AnalyticsView from "@/shared/analytics-view.astro";
import RichContent from "@/features/blog/rich-content";
import PostLikeButton from "@/features/blog/post-like-button";
import CommentsView from "@/features/blog/comments-view";
import { fetchCurrentMemberId } from "@/features/blog/authors";
import { PostCard } from "@/features/blog/blog-feed-view";
import { categoryPath, fetchPostBySlug, fetchRelatedPosts, postMetaLine, postPath, tagPath } from "@/features/blog/posts";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";
import { fetchBlogCategories, fetchTagsByIds, inIdOrder } from "@/features/blog/taxonomy";
import { getSiteChrome } from "@/features/site-chrome/site-chrome";
import type { BlogCategory, BlogTag, PostDetail, PostSummary } from "@/features/blog/types";
import { WIX_APPS } from "@wix/essentials";
import { SEO } from "@wix/seo/components";
import { loadSEOTagsServiceConfig } from "@wix/seo/services";
import { seoTags } from "@wix/seo";

export const wixMetadata = {
  appDefId: WIX_APPS.blogs.id,
  pageIdentifier: WIX_APPS.blogs.postPageMetadata.pageIdentifier,
  identifiers: {
    slug: WIX_APPS.blogs.postPageMetadata.identifiers.slug,
  },
};

// The rest param arrives decoded and re-joined ("a/b" for /blog/a/b) — exactly the stored slug.
const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}
const locale = currentLocale(Astro.url, Astro.request.headers);

// Behind Wix's proxy the request URL is internal — the real public page URL arrives on
// x-wix-forwarded-url; the SEO service needs the public one.
const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;

let post: PostDetail | null = null;
let allCategories: BlogCategory[] = [];
let postTags: BlogTag[] = [];
let related: PostSummary[] = [];
let seoTagsServiceConfig = null;
let currentMemberId: string | null = null;
try {
  [post, allCategories, seoTagsServiceConfig, currentMemberId] = await Promise.all([
    fetchPostBySlug(slug, Astro.request.headers, locale),
    fetchBlogCategories(),
    loadSEOTagsServiceConfig({
      pageUrl,
      itemType: seoTags.ItemType.BLOG_POST,
      itemData: { slug },
    }).catch(() => null),
    // Server-side the ambient session IS the request's cookies: a logged-in member resolves, an
    // anonymous visitor's 403 stays here and never reaches the browser console. The null (or the
    // id) is passed to the comments island, which then skips its own failing client-side read.
    fetchCurrentMemberId().catch(() => null),
  ]);
  if (post) {
    // Tags are read BY ID (a blog's tags run to hundreds); the related strip needs the post's ids.
    [postTags, related] = await Promise.all([fetchTagsByIds(post.tagIds), fetchRelatedPosts(post, undefined, Astro.request.headers, locale)]);
  }
} catch {
  // Guarded: an unhandled SSR throw truncates the response mid-stream.
}

if (!post) {
  return new Response(null, { status: 404 });
}

// Chips in the POST's order (its categoryIds), ids that resolved to nothing dropped.
const postCategories = inIdOrder(post.categoryIds, allCategories);
// One source of head tags: the SEO service when it resolved (it carries the owner's overrides);
// otherwise the DTO's own seoTitle/seoDescription (override → title; override → excerpt → body).
const head = seoTagsServiceConfig ? {} : { title: post.seoTitle, description: post.seoDescription };
const labels = await getSiteChrome(Astro.request.headers);
const label = (key: string, fallback: string) => labels[key] || fallback;
---

<SiteLayout {...head}>
  {seoTagsServiceConfig && <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />}

  <article class="mx-auto max-w-3xl px-6">
    <AnalyticsView event="ArticleView" payload={{ post_id: post.id, slug: post.slug }} />
    {
      postCategories.length > 0 && (
        <p class="eyebrow text-center">
          {postCategories.map((c, i) => (
            <>
              {i > 0 && " · "}
              <a href={localizedHref(locale, categoryPath(c.slug))} class="no-underline">
                {c.label}
              </a>
            </>
          ))}
        </p>
      )
    }
    <h1 class="font-display mt-4 text-center text-4xl font-medium leading-tight sm:text-5xl">{post.title}</h1>
    <p class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm text-muted-foreground">
      {post.authorAvatarUrl && <img src={post.authorAvatarUrl} alt="" width="24" height="24" class="h-6 w-6 rounded-full object-cover" onerror="this.remove()" />}
      {post.authorName && <span>{post.authorName}</span>}
      {post.authorName && postMetaLine(post) && <span aria-hidden="true">·</span>}
      <time datetime={post.dateISO}>{postMetaLine(post)}</time>
    </p>
    {
      post.coverUrl && (
        <div class="mt-8 max-h-[45vh] w-full overflow-hidden bg-secondary">
          <img src={post.coverUrl} alt={post.coverAlt} class="h-full max-h-[45vh] w-full object-cover" />
        </div>
      )
    }
    <div class="mt-10 post-body">
      <RichContent client:only="react" content={post.richContent} fallbackParagraphs={post.paragraphs} />
    </div>
    <div class="mt-10 border-t border-border pt-4 text-center">
      <PostLikeButton client:load post={post} />
    </div>
    {
      postTags.length > 0 && (
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          {postTags.map((t) => (
            <a href={localizedHref(locale, tagPath(t.slug))} class="rounded-control border border-border px-3 py-1 text-xs font-medium text-muted-foreground no-underline">
              {t.label}
            </a>
          ))}
        </div>
      )
    }
    {
      related.length > 0 && (
        <aside class="mt-14">
          <h2 class="font-display mb-6 text-center text-2xl font-medium">{label("relatedPosts", "Altri racconti")}</h2>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} postHref={(slug) => localizedHref(locale, postPath(slug))} />
            ))}
          </div>
        </aside>
      )
    }
    {
      post.commentingEnabled && post.referenceId && (
        <div class="mt-14">
          <CommentsView client:load referenceId={post.referenceId} currentMemberId={currentMemberId} />
        </div>
      )
    }
  </article>
</SiteLayout>

<style is:global>
  /* The ricos viewer ships a 15px block margin on every paragraph and 28px/36px headings, which
     reads as brutal gaps on this layout. Retune the post body to the site's editorial rhythm:
     tighter, heading-led spacing with comfortable line-height. */
  .post-body .ricos-content {
    --ricos-custom-p-line-height: 1.8;
  }
  .post-body .ricos-content p {
    margin-block: 0.85em;
  }
  .post-body .ricos-content h2,
  .post-body .ricos-content h3 {
    margin-block: 1.9em 0.55em;
    font-size: 1.25em;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .post-body .ricos-content h2 {
    font-size: 1.4em;
  }
  .post-body .ricos-content h2 + p,
  .post-body .ricos-content h3 + p {
    margin-block-start: 0.35em;
  }
  .post-body .ricos-content ul,
  .post-body .ricos-content ol {
    margin-block: 0.9em;
    padding-inline-start: 1.4em;
  }
  .post-body .ricos-content li {
    margin-block: 0.4em;
  }
  .post-body .ricos-content blockquote {
    margin-block: 1.4em;
  }
</style>
