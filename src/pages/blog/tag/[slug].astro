---
// Tag page — the feed filtered to one tag, with the tag's label as its header (a tag carries no
// description or cover). No SEO item type exists for tags (the enum has BLOG_POST and BLOG_CATEGORY
// only) and Wix's own sitemap lists no tag pages, so this page is a plain page: the layout's
// title comes from the tag's label. Keep the frontmatter; restyle the template. The first page is
// fetched SERVER-SIDE with the tag filter and seeded together with the filter id. An unknown slug is
// a real 404 (Wix's router answers 200 + empty feed; on a headless site that page does not exist).
import SiteLayout from "@/app/layout.astro";
import Feed from "@/features/blog/feed";
import { currentLocale } from "@/features/i18n/current-locale";
import { fetchPosts } from "@/features/blog/posts";
import { fetchBlogCategories, fetchBlogTags, fetchTagBySlug } from "@/features/blog/taxonomy";
import { getSiteChrome } from "@/features/site-chrome/site-chrome";
import type { BlogCategory, BlogTag, PostPage } from "@/features/blog/types";

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}

let tag: BlogTag | null = null;
let page: PostPage | undefined;
let categories: BlogCategory[] = [];
let tags: BlogTag[] = [];
try {
  [tag, categories, tags] = await Promise.all([fetchTagBySlug(slug), fetchBlogCategories(), fetchBlogTags()]);
  const locale = currentLocale(Astro.url, Astro.request.headers);
  if (tag) page = await fetchPosts({ tagId: tag.id, headers: Astro.request.headers, locale });
} catch {
  // Guarded: an unhandled SSR throw truncates the response mid-stream. With no seed the island
  // fetches the filtered page client-side and shows its own error state.
}

if (!tag) {
  return new Response(null, { status: 404 });
}
const locale = currentLocale(Astro.url, Astro.request.headers);
const labels = await getSiteChrome(Astro.request.headers);
const label = (key: string, fallback: string) => labels[key] || fallback;
---

<SiteLayout headFallback title={tag.label}>
  <header class="mb-10 mt-12 px-6 text-center">
    <p class="eyebrow">{label("tagLabel", "Tema")}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl">{tag.label}</h1>
  </header>

  <div class="mx-auto max-w-7xl px-6 pb-24">
    <Feed
      client:load
      initialPage={page}
      initialTagId={tag.id}
      initialCategories={categories}
      initialTags={tags}
      emptyMessage={label("noTagPosts", "Nessun articolo con questo tema ancora.")}
      locale={locale}
      labels={labels}
    />
  </div>
</SiteLayout>
