---
import SiteLayout from "@/app/layout.astro";
import ArtisticParallax from "@/features/home/artistic-parallax.astro";
import { getSitePageContent, getHomeContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import type { Locale } from "@/features/i18n/locale";
import "@/features/site-content/site-content.css";

const locale = currentLocale(Astro.url, Astro.request.headers);
const [content, home] = await Promise.all([
  getSitePageContent("fine-art", Astro.request.headers),
  getHomeContent(Astro.request.headers),
]);

const WHERE_CTA: Record<Locale, string> = {
  it: "Dove acquistarle",
  es: "Dónde comprarlas",
  en: "Where to buy them",
  de: "Wo erhältlich",
};
---

<SiteLayout title={content.title} description={content.intro}>
  <ArtisticParallax
    ctaHref="#dove-vederle"
    ctaLabel={WHERE_CTA[locale]}
    title={home.parallaxTitle}
    line={home.parallaxLine}
  />

  <section class="border-b border-border px-6 pb-12 pt-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section id="dove-vederle" class="site-content-body mx-auto max-w-3xl scroll-mt-24 px-6 py-14" set:html={content.bodyHtml} />
</SiteLayout>
