---
import SiteLayout from "@/app/layout.astro";
import VideoGrid from "@/features/video/video-grid.astro";
import { curatedVideos } from "@/features/video/curated";
import { fetchChannelFeed } from "@/features/video/feed";
import { getSitePageContent } from "@/features/site-content/site-content";

const feed = await fetchChannelFeed();
const curatedIds = new Set(curatedVideos.map((video) => video.id));
const channelVideos = feed.filter((video) => !curatedIds.has(video.id));

const [featured, ...rest] = curatedVideos;
const content = await getSitePageContent("video");

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: curatedVideos.map((video, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "VideoObject",
      name: video.title,
      embedUrl: `https://www.youtube.com/embed/${video.id}`,
      thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
      uploadDate: video.note,
    },
  })),
};
---

<SiteLayout title={content.title} description={content.intro}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(videoSchema)} slot="seo-tags" />
  <script>
    import "@justinribeiro/lite-youtube";

    // The featured video autoplays muted: a programmatic click loads the iframe
    // through the component's own click handler, whose generated embed URL sets
    // autoplay=1; the mute=1 param above keeps it muted, which is what lets the
    // browser autoplay it. The `autoload` + autoplay-in-params combination does
    // NOT work (the component writes autoplay=0 first, and YouTube keeps the
    // first value).
    customElements.whenDefined("lite-youtube").then(() => {
      const featured = document.querySelector<HTMLElement>("lite-youtube[data-autoplay-featured]");
      featured?.click();
    });
  </script>

  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="lg:col-span-2">
        <figure>
          <lite-youtube
            videoid={featured.id}
            videoTitle={featured.title}
            playlabel={`Riproduci: ${featured.title}`}
            params="mute=1&rel=0"
            data-autoplay-featured
            class="border border-border"
          />
          <figcaption class="mt-4 flex flex-col gap-1">
            <span class="font-display text-lg font-medium">{featured.title}</span>
            <span class="text-sm text-muted-foreground">In evidenza · {featured.note}</span>
          </figcaption>
        </figure>
      </div>
      {
        rest.map((video) => (
          <figure>
            <lite-youtube
              videoid={video.id}
              videoTitle={video.title}
              playlabel={`Riproduci: ${video.title}`}
              params="rel=0"
              class="border border-border"
            />
            <figcaption class="mt-3 flex items-baseline justify-between gap-3">
              <span class="text-sm font-medium">{video.title}</span>
              <span class="text-xs text-muted-foreground">{video.note}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {
    channelVideos.length > 0 && (
      <section class="mx-auto max-w-6xl border-t border-border px-6 pb-24 pt-14">
        <h2 class="font-display text-2xl font-medium sm:text-3xl">Dal canale</h2>
        <p class="mt-2 text-sm text-muted-foreground">Gli ultimi video pubblicati sul canale YouTube di Stefano.</p>
        <div class="mt-8">
          <VideoGrid videos={channelVideos.map(({ id, title }) => ({ id, title }))} />
        </div>
        <div class="mt-10 text-center">
          <a
            href="https://www.youtube.com/@stefanolunardiphotographer7802/videos"
            target="_blank"
            rel="noopener"
            class="rounded-control border border-foreground bg-foreground px-6 py-3 text-sm font-medium text-primary-foreground no-underline hover:border-accent hover:bg-accent"
          >
            Guarda tutti i video sul canale
          </a>
        </div>
      </section>
    )
  }
</SiteLayout>
