---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import "@/features/site-content/site-content.css";

const content = await getSitePageContent("location", Astro.request.headers);
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="site-content-body mx-auto max-w-3xl px-6 py-14" set:html={content.bodyHtml} />

  <div class="mx-auto max-w-3xl px-6 pb-24 text-center">
    <p class="font-display text-2xl italic">La vostra location non è in lista? Scrivetemi</p>
    <a href="/contatti" class="mt-6 inline-block rounded-control border border-foreground bg-foreground px-8 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:border-accent hover:bg-accent">Scrivetemi</a>
  </div>
</SiteLayout>
