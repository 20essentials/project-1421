---
import SiteLayout from "@/app/layout.astro";
import LegalPage from "@/features/legal/legal-page.astro";
import { getSitePageContent } from "@/features/site-content/site-content";

const content = await getSitePageContent("cookie-policy", Astro.request.headers);
---

<SiteLayout title={content.title} description={content.intro}>
  <LegalPage content={content} />
</SiteLayout>
