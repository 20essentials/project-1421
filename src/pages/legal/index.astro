---
import SiteLayout from "@/app/layout.astro";
import { getLegalDocument, legalGroups } from "@/features/legal/documents";
---

<SiteLayout
  title="Documenti legali — Informazioni, privacy e accessibilità"
  description="Termini, privacy, cookie, accessibilità e altre informazioni legali relative all'utilizzo del sito."
>
  <div class="mx-auto max-w-6xl px-6 pb-24 pt-16">
    <header class="border-b border-border pb-10">
      <p class="eyebrow">Documenti legali</p>
      <h1 class="font-display mt-4 text-4xl font-medium sm:text-5xl">Informazioni e impegni</h1>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        Un unico punto di accesso ai documenti che regolano l'utilizzo del sito, il trattamento dei dati e l'impegno verso un'esperienza accessibile.
      </p>
    </header>
    <div class="grid gap-12 pt-12 lg:grid-cols-2">
      {legalGroups.map((group) => (
        <section class="border-b border-border pb-10">
          <h2 class="font-display text-2xl font-medium">{group.label}</h2>
          <ul class="mt-5 space-y-3">
            {group.slugs.map((slug) => {
              const doc = getLegalDocument(slug);
              if (!doc) return null;
              return (
                <li>
                  <a href={`/legal/${slug}`} class="group flex items-start justify-between gap-4 no-underline">
                    <span>
                      <span class="block text-sm text-foreground group-hover:text-accent">{doc.title}</span>
                      <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{doc.summary}</span>
                    </span>
                    <span aria-hidden="true" class="text-muted-foreground">↗</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
    <p class="mt-10 text-sm leading-relaxed text-muted-foreground">
      Per domande o segnalazioni è possibile utilizzare le informazioni di contatto riportate nel footer del sito.
    </p>
  </div>
</SiteLayout>
