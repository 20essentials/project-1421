---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";

// Presentation structure of the legal hub (labels + page order); each document's
// title/summary come live from its own Single Item collection.
const groups = [
  { label: "Fondamentali", slugs: ["termini-e-condizioni", "privacy", "accessibilita"] },
  { label: "Privacy e principi", slugs: ["carta-accordo-privacy", "manifesto-soberania-digitale", "protezione-dati"] },
  { label: "Utilizzo del sito", slugs: ["termini-di-utilizzo", "accordo-utente", "cookie-policy", "avviso-legale"] },
  { label: "Acquisti", slugs: ["resi-e-rimborsi"] },
] as const;

const content = await getSitePageContent("legal-index", Astro.request.headers);
const locale = currentLocale(Astro.url, Astro.request.headers);
const docs = new Map(
  await Promise.all(
    groups.flatMap((group) => group.slugs).map(async (slug) => {
      try {
        return [slug, await getSitePageContent(slug, Astro.request.headers)] as const;
      } catch {
        // A collection with no item is skipped from the listing, not a failed page.
        return [slug, null] as const;
      }
    }),
  ),
);
---

<SiteLayout title={content.title} description={content.intro}>
  <div class="mx-auto max-w-6xl px-6 pb-24 pt-16">
    <header class="border-b border-border pb-10">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 class="font-display mt-4 text-4xl font-medium sm:text-5xl">{content.title}</h1>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
    </header>
    <div class="grid gap-12 pt-12 lg:grid-cols-2">
      {
        groups.map((group) => (
          <section class="border-b border-border pb-10">
            <h2 class="font-display text-2xl font-medium">{group.label}</h2>
            <ul class="mt-5 space-y-3">
              {group.slugs.map((slug) => {
                const doc = docs.get(slug);
                if (!doc) return null;
                return (
                  <li>
                    <a href={localizedHref(locale, `/legal/${slug}`)} class="group flex items-start justify-between gap-4 no-underline">
                      <span>
                        <span class="block text-sm text-foreground group-hover:text-accent">{doc.title}</span>
                        <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{doc.intro}</span>
                      </span>
                      <span aria-hidden="true" class="text-muted-foreground">↗</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="mt-10 text-sm leading-relaxed text-muted-foreground">
      Per domande o segnalazioni è possibile utilizzare le informazioni di contatto riportate nel footer del sito.
    </p>
  </div>
</SiteLayout>
