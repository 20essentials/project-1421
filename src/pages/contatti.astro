---
import SiteLayout from "@/app/layout.astro";
import SchemaForm from "@/features/forms/schema-form";
import { getForm } from "@/features/forms/forms";
import { getSiteChrome } from "@/features/site-chrome/site-chrome";
import type { FormDto } from "@/features/forms/types";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { localizedHref } from "@/features/i18n/localized-path";

const FORM_ID = "9ab7aa27-14c9-4278-a9e5-c530df27d1ac";

let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID, Astro.request.headers);
} catch {
}

const content = await getSitePageContent("contatti", Astro.request.headers);
const labels = await getSiteChrome(Astro.request.headers);
const label = (key: string, fallback: string) => labels[key] || fallback;
const locale = currentLocale(Astro.url, Astro.request.headers);
const privacyConsent = {
  href: localizedHref(locale, "/legal/privacy"),
  prefix: label("contactPrivacyConsentPrefix", "Ho letto l'"),
  linkLabel: label("contactPrivacyConsentLink", "informativa privacy"),
  suffix: label("contactPrivacyConsentSuffix", "."),
  errorMessage: label("contactPrivacyConsentError", "Devi accettare l'informativa privacy per inviare la richiesta."),
};
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-14">
    <h2 class="font-display text-2xl font-medium sm:text-3xl">{label("contactMessageTitle", "Il vostro messaggio")}</h2>
    <p class="mt-2 text-sm text-muted-foreground">{label("contactResponseNote", "Risposta entro 48 ore, senza fretta e senza pressione commerciale.")}</p>
    <div class="mt-8">
      <SchemaForm client:load formId={FORM_ID} initialForm={form ?? undefined} privacyConsent={privacyConsent} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 border-t border-border py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
      <div>
        <p class="eyebrow">{label("directContacts", "Contatti diretti")}</p>
        <div class="mt-4 flex flex-col gap-2 text-sm">
          <a href="tel:+393387513113" class="text-foreground no-underline hover:text-accent">+39 338 751 3113 (Italia)</a>
          <a href="tel:+436767517274" class="text-foreground no-underline hover:text-accent">+43 676 751 7274 (Austria)</a>
          <a href="mailto:studio@stefanolunardi.com" class="text-foreground no-underline hover:text-accent">studio@stefanolunardi.com</a>
        </div>
        <p class="eyebrow mt-8">{label("zones", "Zone")}</p>
        <p class="mt-3 text-sm text-muted-foreground">Villach (Austria) · Udine (Italia) · Treviso (Italia)</p>
      </div>
      <div>
        <p class="eyebrow">{label("firstMeetingTitle", "Cosa succede nel primo incontro")}</p>
        <ul class="mt-4 flex flex-col gap-3 text-sm leading-relaxed text-muted-foreground">
          <li>Vedere il portfolio completo e gallery di matrimoni reali</li>
          <li>Capire il metodo dei tre incontri preparatori</li>
          <li>Scoprire la differenza tra scatto analogico e digitale</li>
          <li>Domande libere, senza fretta e senza pressione</li>
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
