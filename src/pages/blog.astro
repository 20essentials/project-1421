---
import SiteLayout from "@/app/layout.astro";
import Feed from "@/features/blog/feed";
import { currentLocale } from "@/features/i18n/current-locale";
import { fetchPosts } from "@/features/blog/posts";
import { fetchBlogCategories, fetchBlogTags } from "@/features/blog/taxonomy";
import { getSiteChrome } from "@/features/site-chrome/site-chrome";
import type { BlogCategory, BlogTag, PostPage } from "@/features/blog/types";

let page: PostPage | undefined;
let categories: BlogCategory[] = [];
let tags: BlogTag[] = [];
let failed = false;
const locale = currentLocale(Astro.url, Astro.request.headers);
try {
  [page, categories, tags] = await Promise.all([
    fetchPosts({ headers: Astro.request.headers, locale }),
    fetchBlogCategories(),
    fetchBlogTags(),
  ]);
} catch {
  failed = true;
}
const labels = await getSiteChrome(Astro.request.headers);
const label = (key: string, fallback: string) => labels[key] || fallback;
---

<SiteLayout title={label("blogTitle", "Storie")} description={label("blogDescription", "Racconti di matrimoni reali, location tra Italia e Austria e consigli per le coppie.")}>
  <header class="border-b border-border px-6 pb-10 text-center">
    <h1 class="font-display text-4xl font-medium sm:text-5xl">{label("blogHeading", "Storie, location e consigli")}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{label("blogIntro", "Dietro l'obiettivo: il metodo, le scelte, le storie.")}</p>
  </header>
  <div class="mx-auto max-w-7xl px-6 pt-12 pb-24">
    <Feed
      client:load
      initialPage={failed ? undefined : page}
      initialCategories={categories}
      initialTags={tags}
      locale={locale}
      labels={labels}
    />
  </div>
</SiteLayout>
