---
import SiteLayout from "@/app/layout.astro";
import { getSitePageContent } from "@/features/site-content/site-content";
import { currentLocale } from "@/features/i18n/current-locale";
import { type Locale } from "@/features/i18n/locale";
import { localizedHref } from "@/features/i18n/localized-path";
import { formatReviewDate, REVIEWS } from "@/features/reviews/reviews";

const locale = currentLocale(Astro.url, Astro.request.headers);

const ratingCount = 10;
const ratingConsigliato = "100%";

const UI: Record<
  Locale,
  {
    verified: string;
    sposi: string;
    reviewsHeading: string;
    profilesHeading: string;
    profilesNote: string;
    profiles: string[];
    verifyCta: string;
  }
> = {
  it: {
    verified: "{count} recensioni verificate · consigliato dal {percent} delle coppie",
    sposi: "Sposi",
    reviewsHeading: "Le recensioni, una per una",
    profilesHeading: "I profili pubblici",
    profilesNote:
      "Tutte le recensioni verificate sono leggibili anche sui profili: testo originale, voti e risposte.",
    profiles: ["Opinioni su matrimonio.com", "Recensioni su Wezoree", "Recensioni su 5 Star Wedding Directory"],
    verifyCta: "Verifica la tua data",
  },
  es: {
    verified: "{count} reseñas verificadas · recomendado por el {percent} de las parejas",
    sposi: "Novios",
    reviewsHeading: "Las reseñas, una por una",
    profilesHeading: "Los perfiles públicos",
    profilesNote:
      "Todas las reseñas verificadas también se pueden leer en los perfiles: texto original, votos y respuestas.",
    profiles: ["Opiniones en matrimonio.com", "Reseñas en Wezoree", "Reseñas en 5 Star Wedding Directory"],
    verifyCta: "Comprueba vuestra fecha",
  },
  en: {
    verified: "{count} verified reviews · recommended by {percent} of couples",
    sposi: "Newlyweds",
    reviewsHeading: "The reviews, one by one",
    profilesHeading: "Public profiles",
    profilesNote:
      "All verified reviews are also readable on the profiles: original text, ratings and replies.",
    profiles: ["Reviews on matrimonio.com", "Reviews on Wezoree", "Reviews on 5 Star Wedding Directory"],
    verifyCta: "Check your date",
  },
  de: {
    verified: "{count} verifizierte Rezensionen · von {percent} der Paare empfohlen",
    sposi: "Brautpaar",
    reviewsHeading: "Die Rezensionen, eine nach der anderen",
    profilesHeading: "Öffentliche Profile",
    profilesNote:
      "Alle verifizierten Rezensionen sind auch auf den Profilen lesbar: Originaltext, Bewertungen und Antworten.",
    profiles: ["Bewertungen auf matrimonio.com", "Rezensionen auf Wezoree", "Rezensionen auf 5 Star Wedding Directory"],
    verifyCta: "Prüfen Sie Ihr Datum",
  },
};
const ui = UI[locale];
const verifiedLine = ui.verified.replace("{count}", String(ratingCount)).replace("{percent}", ratingConsigliato);

const rating = { value: "5.0", max: 5, count: ratingCount, consigliato: ratingConsigliato };

const profili = [
  { href: "https://www.matrimonio.com/fotografo-matrimonio/stefanolunardi-photographer--e33485/opinioni", label: "Opinioni su matrimonio.com" },
  { href: "https://wezoree.com/it/vendors/profile/20527-photographers-stefano-lunardi/reviews", label: "Recensioni su Wezoree" },
  { href: "https://5starweddingdirectory.com/wedding-photographers/austria/stefano-lunardi/reviews/", label: "Recensioni su 5 Star Wedding Directory" },
];
const content = await getSitePageContent("recensioni", Astro.request.headers);
---

<SiteLayout title={content.title} description={content.intro}>
  <section class="border-b border-border px-6 pb-12 text-center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 class="font-display mt-3 text-4xl font-medium sm:text-5xl md:text-6xl">{content.title}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">{content.intro}</p>
    <p class="mt-6 flex items-center justify-center gap-3 text-sm text-muted-foreground">
      <span class="font-display text-2xl text-accent">{rating.value}</span>
      <span aria-hidden="true" class="text-accent">★★★★★</span>
      <span>{verifiedLine}</span>
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-14">
    <h2 class="font-display text-3xl font-medium">{ui.reviewsHeading}</h2>
    <div class="mt-8 flex flex-col gap-4">
      {
        REVIEWS.map((review) => (
          <article class="border border-border bg-secondary px-6 py-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="font-display text-xl">{review.name}</p>
              <p class="text-xs uppercase tracking-widest text-muted-foreground">
                {ui.sposi} · {formatReviewDate(locale, review.date)} · {review.location}
              </p>
            </div>
            <p class="mt-1 text-sm text-accent" aria-hidden="true">
              ★★★★★
            </p>
            {review.text.split("\n\n").map((p) => (
              <p class="mt-3 leading-relaxed text-muted-foreground first-of-type:mt-4">{p}</p>
            ))}
          </article>
        ))
      }
    </div>

    <h2 class="font-display mt-14 text-3xl font-medium">{ui.profilesHeading}</h2>
    <p class="mt-4 leading-relaxed text-muted-foreground">
      {ui.profilesNote}
    </p>
    <div class="mt-6 flex flex-col gap-3 text-sm">
      {
        profili.map((p, i) => (
          <a href={p.href} target="_blank" rel="noopener" class="text-accent underline underline-offset-4">
            {ui.profiles[i] ?? p.label}
          </a>
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <a
        href={localizedHref(locale, "/contatti")}
        class="inline-block rounded-control border border-foreground px-8 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-accent hover:text-accent"
      >
        {ui.verifyCta}
      </a>
    </div>
  </section>
</SiteLayout>
